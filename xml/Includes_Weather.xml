<?xml version="1.0" encoding="UTF-8"?>
<includes>

  <include name="WeatherInfoLabel">
		<param name="font">font32</param>
		<param name="textcolor">darkgrey</param>
		<param name="height">50</param>
		<param name="visible">true</param>
		<definition>
			<control type="label">
				<align>left</align>
				<width>418</width>
				<height>$PARAM[height]</height>
				<aligny>center</aligny>
				<font>$PARAM[font]</font>
				<textcolor>$PARAM[textcolor]</textcolor>
				<shadowcolor>text_shadow</shadowcolor>
				<label>$PARAM[label]</label>
				<scroll>true</scroll>
				<scrollspeed>170</scrollspeed>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<include name="WeatherInfoPanel">
		<control type="group">
			<width>418</width>
			<visible>ControlGroup(15000).HasFocus + !String.IsEmpty(Weather.plugin)</visible>
			<animation effect="fade" time="300">VisibleChange</animation>
			<include>OpenClose_Left</include>
			<control type="grouplist">
				<left>40</left>
				<top>0</top>
				<bottom>0</bottom>
				<width>418</width>
				<orientation>vertical</orientation>
				<align>center</align>
				<itemgap>0</itemgap>
				<include content="WeatherInfoLabel">
					<param name="label" value="[UPPERCASE]$INFO[Weather.Location][/UPPERCASE]"/>
					<param name="font" value="font40_title"/>
					<param name="textcolor" value="$VAR[FocusColorTheme]"/>
					<param name="height" value="66"/>
				</include>
				<include content="WeatherInfoLabel">
					<param name="label" value="$INFO[Window(weather).Property(Updated),[COLOR white]UPDATED: [/COLOR]]"/>
					<param name="font" value="font27"/>
					<param name="height" value="50"/>
				</include>
				<control type="group">
					<width>418</width>
					<height>40</height>
				</control>
				<include content="WeatherInfoLabel">
					<param name="label" value="CURRENTLY"/>
					<param name="font" value="font36_title"/>
					<param name="textcolor" value="$VAR[FocusColorTheme]"/>
					<param name="height" value="68"/>
				</include>
				<include content="WeatherInfoLabel">
					<param name="label" value="$INFO[Weather.Conditions,[COLOR white]CONDITIONS: [/COLOR]]"/>
				</include>
				<include content="WeatherInfoLabel">
					<param name="label" value="$INFO[Weather.Temperature,[COLOR white]TEMPERATURE: [/COLOR]]"/>
				</include>
				<include content="WeatherInfoLabel">
					<param name="label" value="[COLOR white]FEELS LIKE: [/COLOR]$INFO[Window(weather).Property(Current.FeelsLike)]$INFO[System.TemperatureUnits]"/>
					<param name="visible" value="!String.IsEmpty(Window(weather).Property(Current.FeelsLike))"/>
				</include>
				<include content="WeatherInfoLabel">
					<param name="label" value="$INFO[Window(weather).Property(Current.Humidity),[COLOR white]HUMIDITY: [/COLOR]]"/>
					<param name="visible" value="!String.IsEmpty(Window(weather).Property(Current.Humidity))"/>
				</include>
				<include content="WeatherInfoLabel">
					<param name="label" value="[COLOR white]DEW POINT: [/COLOR]$INFO[Window(weather).Property(Current.DewPoint)]$INFO[System.TemperatureUnits]"/>
					<param name="visible" value="!String.IsEmpty(Window(weather).Property(Current.DewPoint))"/>
				</include>
				<include content="WeatherInfoLabel">
					<param name="label" value="$INFO[Window(weather).Property(Current.Wind),[COLOR white]WINDS: [/COLOR]]"/>
					<param name="visible" value="!String.IsEmpty(Window(weather).Property(Current.Wind))"/>
				</include>
				<include content="WeatherInfoLabel">
					<param name="label" value="$INFO[Window(weather).Property(Current.Precipitation),[COLOR white]PRECIPITATION: [/COLOR]]"/>
					<param name="visible" value="!String.IsEmpty(Window(weather).Property(Current.Precipitation))"/>
				</include>
				<include content="WeatherInfoLabel">
					<param name="label" value="$INFO[Window(weather).Property(Today.Sunrise),[COLOR white]SUNRISE: [/COLOR]]"/>
					<param name="visible" value="!String.IsEmpty(Window(weather).Property(Today.Sunrise))"/>
				</include>
				<include content="WeatherInfoLabel">
					<param name="label" value="$INFO[Window(weather).Property(Today.Sunset),[COLOR white]SUNSET: [/COLOR]]"/>
					<param name="visible" value="!String.IsEmpty(Window(weather).Property(Today.Sunset))"/>
				</include>
			</control>
		</control>
	</include>

	<include name="HomeWallWeather">
		<definition>
			<control type="group">
				<include content="HomeWallFrame">
					<param name="list_id" value="$PARAM[list_id]"/>
					<param name="visible" value="$PARAM[visible]"/>
				</include>
				<control type="panel" id="$PARAM[list_id]">
					<include content="HomeWallCommon">
						<param name="list_id" value="$PARAM[list_id]"/>
						<param name="row_id" value="$PARAM[row_id]"/>
						<param name="visible" value="$PARAM[visible]"/>
					</include>
					<itemlayout width="283" height="389">
						<control type="group">
							<include content="HomeWallUnfocusedAnimations">
								<param name="list_id" value="$PARAM[list_id]"/>
							</include>
							<include content="WeatherWallLayout">
								<param name="list_id" value="$PARAM[list_id]"/>
							</include>
						</control>
					</itemlayout>
					<focusedlayout width="283" height="389" infoupdate="30">
						<control type="group">
							<depth>DepthContentPopout</depth>
							<control type="group">
								<include content="HomeWallFocusAnimations">
									<param name="list_id" value="$PARAM[list_id]"/>
								</include>
								<include content="WeatherWallLayout">
									<param name="list_id" value="$PARAM[list_id]"/>
									<param name="focused" value="true"/>
								</include>
							</control>
							<include>FocusBounce</include>
						</control>
					</focusedlayout>
					<include>$PARAM[content_include]</include>
				</control>
			</control>
		</definition>
	</include>

	<include name="WeatherMapListItem">
		<definition>
			<item>
				<label>$INFO[Window(weather).Property(Map.$PARAM[map_index].Heading)]</label>
				<onclick>noop</onclick>
				<property name="Area">$INFO[Window(weather).Property(Map.$PARAM[map_index].Area)]</property>
				<property name="Layer">$INFO[Window(weather).Property(Map.$PARAM[map_index].Layer)]</property>
				<property name="Legend">$INFO[Window(weather).Property(Map.$PARAM[map_index].Legend)]</property>
				<visible>!String.IsEmpty(Window(weather).Property(Map.$PARAM[map_index].Area))</visible>
			</item>
		</definition>
	</include>

	<include name="WeatherMapItems">
		<content>
			<include content="WeatherMapListItem">
				<param name="map_index" value="1"/>
			</include>
			<include content="WeatherMapListItem">
				<param name="map_index" value="2"/>
			</include>
			<include content="WeatherMapListItem">
				<param name="map_index" value="3"/>
			</include>
			<include content="WeatherMapListItem">
				<param name="map_index" value="4"/>
			</include>
			<include content="WeatherMapListItem">
				<param name="map_index" value="5"/>
			</include>
		</content>
	</include>

	<include name="WeatherMapLayout">
		<param name="focused">false</param>
		<definition>
			<control type="group">
				<top>11</top>
				<left>20</left>
				<width>1384</width>
				<height>770</height>
				<control type="image">
					<texture border="20" colordiffuse="4D000000">masks/radius_23.png</texture>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1384</width>
					<height>770</height>
					<texture diffuse="masks/weathermap.png" background="true">$INFO[ListItem.Property(Area)]</texture>
					<aspectratio scalediffuse="false">scale</aspectratio>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1384</width>
					<height>770</height>
					<texture diffuse="masks/weathermap.png" background="true">$INFO[ListItem.Property(Layer)]</texture>
					<aspectratio scalediffuse="false">scale</aspectratio>
					<colordiffuse>B0FFFFFF</colordiffuse>
				</control>
				<control type="image">
					<right>20</right>
					<top>695</top>
					<width>350</width>
					<height>55</height>
					<texture background="true">$INFO[ListItem.Property(Legend)]</texture>
					<aspectratio align="right" aligny="bottom">keep</aspectratio>
				</control>
				<control type="group">
					<left>20</left>
					<top>20</top>
					<width>280</width>
					<height>55</height>
					<visible>!String.IsEmpty(ListItem.Label)</visible>
					<control type="image">
						<texture border="13" colordiffuse="BF000000">masks/radius_15.png</texture>
					</control>
					<control type="label">
						<align>center</align>
						<aligny>center</aligny>
						<width>280</width>
						<height>50</height>
						<font>p_cache</font>
						<textcolor>unfocused_text</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</control>
				<include content="FocusBorder">
					<param name="list_id" value="$PARAM[list_id]"/>
					<param name="focused" value="$PARAM[focused]"/>
					<param name="radius" value="23"/>
				</include>
			</control>
		</definition>
	</include>

	<include name="HomeWallWeatherMaps">
		<definition>
			<control type="group">
				<visible allowhiddenfocus="true">$PARAM[visible]</visible>
				<animation effect="fade" time="300">Visible</animation>
			<control type="fixedlist" id="$PARAM[list_id]">
				<visible allowhiddenfocus="true">$PARAM[visible]</visible>
				<animation effect="fade" time="300">Visible</animation>
				<left>0</left>
				<top>0</top>
				<width>1424</width>
				<height>1008</height>
				<orientation>vertical</orientation>
				<focusposition>0</focusposition>
				<scrolltime tween="cubic" easing="out">400</scrolltime>
				<onup>SetFocus($PARAM[list_id],0,absolute)</onup>
				<onup>$PARAM[row_id]</onup>
				<onleft condition="!String.IsEqual(Skin.String(onLeftSetting.Home),1)">9000</onleft>
				<onleft condition="String.IsEqual(Skin.String(onLeftSetting.Home),1)">$PARAM[list_id]</onleft>
				<onright>$PARAM[list_id]</onright>
				<onback>SetFocus($PARAM[list_id],0,absolute)</onback>
				<onback condition="!String.IsEqual(Skin.String(onBackSetting.Home),1)">$PARAM[row_id]</onback>
				<onback condition="String.IsEqual(Skin.String(onBackSetting.Home),1)">9000</onback>
				<itemlayout width="1424" height="830">
					<include content="WeatherMapLayout">
						<param name="list_id" value="$PARAM[list_id]"/>
					</include>
				</itemlayout>
				<focusedlayout width="1424" height="830" infoupdate="30">
					<include content="WeatherMapLayout">
						<param name="list_id" value="$PARAM[list_id]"/>
						<param name="focused" value="true"/>
					</include>
				</focusedlayout>
				<include>WeatherMapItems</include>
				</control>
			</control>
		</definition>
	</include>

