<?xml version="1.0" encoding="UTF-8"?>
<includes>

  <include name="WeatherWallLayout">
		<param name="icon">$INFO[ListItem.Icon]</param>
		<param name="label2">$INFO[ListItem.Property(Outlook)]</param>
		<param name="focused">false</param>
		<definition>
			<control type="group">
				<top>11</top>
				<left>20</left>
				<width>249</width>
				<height>355</height>
				<control type="image">
					<texture colordiffuse="4D000000">masks/small-square.png</texture>
					<visible>![$PARAM[focused] + Control.HasFocus($PARAM[list_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)]</visible>
				</control>
				<control type="image">
					<texture colordiffuse="A6000000">masks/small-square.png</texture>
					<visible>$PARAM[focused] + Control.HasFocus($PARAM[list_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)</visible>
				</control>
				<include content="FocusBorder">
					<param name="list_id" value="$PARAM[list_id]"/>
					<param name="focused" value="$PARAM[focused]"/>
				</include>
				<control type="image">
					<centerleft>50%</centerleft>
					<top>14</top>
					<width>160</width>
					<height>160</height>
					<texture colordiffuse="unfocused_text" background="true">$PARAM[icon]</texture>
					<aspectratio>keep</aspectratio>
				</control>
				<control type="textbox">
					<centerleft>50%</centerleft>
					<top>158</top>
					<left>10</left>
					<right>10</right>
					<height>73</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>font25</font>
					<label>$PARAM[label2]</label>
					<autoscroll delay="2000" time="3000" repeat="2000">$PARAM[focused]</autoscroll>
					<textcolor>unfocused_text</textcolor>
				</control>
				<control type="group">
					<centerleft>50%</centerleft>
					<width>269</width>
					<height>110</height>
					<control type="label">
						<top>262</top>
						<align>center</align>
						<aligny>center</aligny>
						<font>font27</font>
						<label>$INFO[ListItem.Label2]</label>
					</control>
					<control type="label">
						<top>305</top>
						<align>center</align>
						<aligny>center</aligny>
						<font>font25</font>
						<textcolor>unfocused_text</textcolor>
						<label>$INFO[ListItem.Label][COLOR unfocused_text]$INFO[ListItem.Property(ShortDate), • ,][/COLOR]</label>
					</control>
				</control>
			</control>
		</definition>
	</include>

</includes>
