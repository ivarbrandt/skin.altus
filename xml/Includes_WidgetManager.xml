<?xml version="1.0" encoding="UTF-8"?>
<includes>

	<!-- Detail panel variables: frozen during widget reorder, live otherwise -->
	<variable name="WM_DetailLabel">
		<value condition="!String.IsEmpty(Window.Property(reorder_widgets))">$INFO[Window.Property(reorder_detail_widget_label)]</value>
		<value>$INFO[Container(4000).ListItem.Property(widget_label)]</value>
	</variable>
	<variable name="WM_DetailDisplayType">
		<value condition="!String.IsEmpty(Window.Property(reorder_widgets))">$INFO[Window.Property(reorder_detail_display_type)]</value>
		<value>$INFO[Container(4000).ListItem.Property(display_type)]</value>
	</variable>
	<variable name="WM_DetailPath">
		<value condition="!String.IsEmpty(Window.Property(reorder_widgets))">$INFO[Window.Property(reorder_detail_widget_path)]</value>
		<value>$INFO[Container(4000).ListItem.Property(widget_path)]</value>
	</variable>
	<variable name="WM_DetailTarget">
		<value condition="!String.IsEmpty(Window.Property(reorder_widgets))">$INFO[Window.Property(reorder_detail_target)]</value>
		<value>$INFO[Container(4000).ListItem.Property(target)]</value>
	</variable>
	<variable name="WM_DetailLimit">
		<value condition="!String.IsEmpty(Window.Property(reorder_widgets))">$INFO[Window.Property(reorder_detail_limit_num)]</value>
		<value>$INFO[Container(4000).ListItem.Property(limit_num)]</value>
	</variable>
	<variable name="WM_DetailSortBy">
		<value condition="!String.IsEmpty(Window.Property(reorder_widgets))">$INFO[Window.Property(reorder_detail_sortby)]</value>
		<value>$INFO[Container(4000).ListItem.Property(sortby)]</value>
	</variable>
	<variable name="WM_DetailSortOrder">
		<value condition="!String.IsEmpty(Window.Property(reorder_widgets))">$INFO[Window.Property(reorder_detail_sortorder)]</value>
		<value>$INFO[Container(4000).ListItem.Property(sortorder)]</value>
	</variable>

	<variable name="WM_WidgetLabelColor">
		<value condition="ControlGroup(5001).HasFocus">$VAR[FocusColorTheme]</value>
		<value>unfocused_text</value>
	</variable>

	<variable name="WidgetManagerItemIcon">
		<value condition="!String.IsEmpty(ListItem.Property(is_weather))">$VAR[WeatherFanartCodeIcon]</value>
		<value>$INFO[ListItem.Property(icon)]</value>
	</variable>

	<!-- Icon diffuse colors that dim when item's hidden property is set, matching the dim label color (60FFFFFF). -->
	<variable name="WM_ItemIconDiffuse">
		<value condition="String.IsEqual(ListItem.Property(hidden),true)">60FFFFFF</value>
		<value>unfocused_text</value>
	</variable>
	<variable name="WM_ItemIconDiffuseFocused">
		<value condition="String.IsEqual(ListItem.Property(hidden),true)">60FFFFFF</value>
		<value>$VAR[FocusColorTheme]</value>
	</variable>

	<include name="WM_DetailRow">
		<param name="width">569</param>
		<param name="value"></param>
		<param name="onleft">4000</param>
		<definition>
			<control type="group">
				<width>$PARAM[width]</width>
				<height>118</height>
				<control type="button" id="$PARAM[id]">
					<width>$PARAM[width]</width>
					<height>89</height>
					<label>$PARAM[label]</label>
					<label2>[COLOR 60FFFFFF]$PARAM[value][/COLOR]</label2>
					<font>font32_bold</font>
					<textoffsetx>30</textoffsetx>
					<aligny>center</aligny>
					<texturefocus border="33" colordiffuse="A6000000">masks/radius_33.png</texturefocus>
					<texturenofocus border="33" colordiffuse="4D000000">masks/radius_33.png</texturenofocus>
					<textcolor>unfocused_text</textcolor>
					<focusedcolor>$VAR[FocusColorTheme]</focusedcolor>
					<onleft>$PARAM[onleft]</onleft>
					<onup>$PARAM[up]</onup>
					<ondown>$PARAM[down]</ondown>
				</control>
				<control type="image">
					<width>$PARAM[width]</width>
					<height>89</height>
					<texture border="33" colordiffuse="$VAR[FocusColorTheme]" infill="false">masks/bordertexture-33_alt.png</texture>
					<visible>Control.HasFocus($PARAM[id])</visible>
				</control>
			</control>
		</definition>
	</include>

	<!-- Inline icon button for widget manager lists. Used inside focusedlayout. -->
	<include name="WM_InlineBtn">
		<param name="btn_color">$VAR[FocusColorTheme]</param>
		<param name="btn_dim">40</param>
		<param name="btn_hide">false</param>
		<param name="btn_slide_weather">false</param>
		<definition>
			<control type="group">
				<left>$PARAM[btn_left]</left>
				<top>$PARAM[btn_top]</top>
				<width>62</width>
				<height>62</height>
				<animation effect="slide" start="0,0" end="47,0" time="0" condition="$PARAM[btn_slide_weather] + String.IsEqual(Window.Property(weather_section),true)">Conditional</animation>
				<visible>Control.HasFocus($PARAM[list_id]) + String.IsEmpty(Window.Property(edit_menu_open)) + !$PARAM[btn_hide]</visible>
				<!-- Icon - highlighted -->
				<control type="image">
					<visible>String.IsEqual(Window.Property($PARAM[btn_prop]),$PARAM[btn_id])</visible>
					<left>10</left>
					<top>10</top>
					<width>42</width>
					<height>42</height>
					<texture colordiffuse="$PARAM[btn_color]">$PARAM[btn_icon]</texture>
					<aspectratio>keep</aspectratio>
				</control>
				<!-- Icon - normal -->
				<control type="image">
					<visible>!String.IsEqual(Window.Property($PARAM[btn_prop]),$PARAM[btn_id])</visible>
					<left>10</left>
					<top>10</top>
					<width>42</width>
					<height>42</height>
					<texture colordiffuse="$PARAM[btn_color]">$PARAM[btn_icon]</texture>
					<animation effect="fade" start="100" end="$PARAM[btn_dim]" time="0" condition="true">Conditional</animation>
					<aspectratio>keep</aspectratio>
				</control>
			</control>
		</definition>
	</include>

</includes>
