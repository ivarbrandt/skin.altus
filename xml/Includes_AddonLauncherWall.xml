<?xml version="1.0" encoding="UTF-8"?>
<includes>

	<include name="AddonLauncherTile">
		<param name="focused">false</param>
		<param name="sublabel">$INFO[ListItem.AddonSummary]</param>
		<param name="has_sublabel">!String.IsEmpty(ListItem.AddonSummary)</param>
		<definition>
			<control type="group">
				<left>18</left>
				<top>18</top>
				<width>675</width>
				<height>122</height>
				<control type="image">
					<texture border="33" colordiffuse="4D000000">masks/radius_33.png</texture>
					<visible>!$PARAM[focused] | !Control.HasFocus($PARAM[list_id]) | !Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)</visible>
				</control>
				<control type="image">
					<texture border="33" colordiffuse="A6000000">masks/radius_33.png</texture>
					<visible>$PARAM[focused] + Control.HasFocus($PARAM[list_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)</visible>
				</control>
				<control type="image">
					<left>21</left>
					<centertop>50%</centertop>
					<width>88</width>
					<height>88</height>
					<texture diffuse="masks/small-square.png" fallback="DefaultAddon.png" background="true">$INFO[ListItem.Icon]</texture>
					<aspectratio>keep</aspectratio>
					<visible>!String.IsEmpty(ListItem.Property(Addon.ID)) | !ListItem.IsFolder</visible>
				</control>
				<control type="image">
					<left>35</left>
					<centertop>50%</centertop>
					<width>60</width>
					<height>60</height>
					<texture colordiffuse="unfocused_text" fallback="DefaultFolder.png">$INFO[ListItem.Icon]</texture>
					<aspectratio>keep</aspectratio>
					<visible>String.IsEmpty(ListItem.Property(Addon.ID)) + ListItem.IsFolder</visible>
					<visible>!$PARAM[focused] | !Control.HasFocus($PARAM[list_id]) | !Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)</visible>
				</control>
				<control type="image">
					<left>35</left>
					<centertop>50%</centertop>
					<width>60</width>
					<height>60</height>
					<texture colordiffuse="$VAR[FocusColorTheme]" fallback="DefaultFolder.png">$INFO[ListItem.Icon]</texture>
					<aspectratio>keep</aspectratio>
					<visible>String.IsEmpty(ListItem.Property(Addon.ID)) + ListItem.IsFolder</visible>
					<visible>$PARAM[focused] + Control.HasFocus($PARAM[list_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)</visible>
				</control>
				<control type="group">
					<left>133</left>
					<width>455</width>
					<visible>!$PARAM[focused] | !Control.HasFocus($PARAM[list_id]) | !Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)</visible>
					<control type="label">
						<height>122</height>
						<aligny>center</aligny>
						<font>font32_bold</font>
						<textcolor>unfocused_text</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>String.IsEmpty(ListItem.Property(Addon.ID)) | ![$PARAM[has_sublabel]]</visible>
					</control>
					<control type="label">
						<top>15</top>
						<height>40</height>
						<aligny>top</aligny>
						<font>font32_bold</font>
						<textcolor>unfocused_text</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>!String.IsEmpty(ListItem.Property(Addon.ID)) + [$PARAM[has_sublabel]]</visible>
					</control>
					<control type="label">
						<top>55</top>
						<height>34</height>
						<aligny>bottom</aligny>
						<font>font23_title</font>
						<textcolor>60FFFFFF</textcolor>
						<label>$PARAM[sublabel]</label>
						<visible>!String.IsEmpty(ListItem.Property(Addon.ID)) + [$PARAM[has_sublabel]]</visible>
					</control>
					<control type="image">
						<left>479</left>
						<centertop>50%</centertop>
						<width>32</width>
						<height>32</height>
						<texture colordiffuse="unfocused_text">$VAR[AddonLauncherStatusIconVar]</texture>
						<visible>!String.IsEmpty(ListItem.Property(Addon.ID))</visible>
					</control>
				</control>
				<control type="group">
					<left>133</left>
					<width>455</width>
					<visible>$PARAM[focused] + Control.HasFocus($PARAM[list_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)</visible>
					<control type="label">
						<height>122</height>
						<aligny>center</aligny>
						<font>font32_bold</font>
						<textcolor>$VAR[FocusColorTheme]</textcolor>
						<scroll>true</scroll>
						<scrollspeed>75</scrollspeed>
						<label>$INFO[ListItem.Label]</label>
						<visible>String.IsEmpty(ListItem.Property(Addon.ID)) | ![$PARAM[has_sublabel]]</visible>
					</control>
					<control type="label">
						<top>15</top>
						<height>40</height>
						<aligny>top</aligny>
						<font>font32_bold</font>
						<textcolor>$VAR[FocusColorTheme]</textcolor>
						<scroll>true</scroll>
						<scrollspeed>75</scrollspeed>
						<label>$INFO[ListItem.Label]</label>
						<visible>!String.IsEmpty(ListItem.Property(Addon.ID)) + [$PARAM[has_sublabel]]</visible>
					</control>
					<control type="label">
						<top>55</top>
						<height>34</height>
						<aligny>bottom</aligny>
						<font>font23_title</font>
						<textcolor>unfocused_text</textcolor>
						<scroll>true</scroll>
						<scrollspeed>75</scrollspeed>
						<label>$PARAM[sublabel]</label>
						<visible>!String.IsEmpty(ListItem.Property(Addon.ID)) + [$PARAM[has_sublabel]]</visible>
					</control>
					<control type="image">
						<left>479</left>
						<centertop>50%</centertop>
						<width>32</width>
						<height>32</height>
						<texture colordiffuse="$VAR[FocusColorTheme]">$VAR[AddonLauncherStatusIconVar]</texture>
						<visible>!String.IsEmpty(ListItem.Property(Addon.ID))</visible>
					</control>
				</control>
				<include content="FocusBorder">
					<param name="list_id" value="$PARAM[list_id]"/>
					<param name="focused" value="$PARAM[focused]"/>
					<param name="radius" value="33"/>
					<param name="border" value="33"/>
				</include>
			</control>
		</definition>
	</include>

	<include name="AddonLauncherPanel">
		<param name="last">false</param>
		<param name="back_has_items">false</param>
		<param name="hold">false</param>
		<param name="item_click">Action(Info)</param>
		<param name="target">addonbrowser</param>
		<param name="sortby">label</param>
		<param name="sortorder">ascending</param>
		<definition>
			<control type="panel" id="$PARAM[root]5$PARAM[level]">
				<visible allowhiddenfocus="true">[$PARAM[visible] + !Container($PARAM[root]5$PARAM[level]).IsUpdating + !String.IsEqual(Window(1100).Property(launcher_$PARAM[root]_pending),$PARAM[level])] | [$PARAM[hold]]</visible>
				<left>0</left>
				<top>159</top>
				<width>1424</width>
				<height>795</height>
				<orientation>vertical</orientation>
				<scrolltime tween="cubic" easing="out">500</scrolltime>
				<preloaditems>1</preloaditems>
				<onup>$PARAM[root]5$PARAM[level]</onup>
				<ondown>$PARAM[root]5$PARAM[level]</ondown>
				<onleft>9000</onleft>
				<onright>$PARAM[root]3$PARAM[level]</onright>
				<pagecontrol>$PARAM[root]3$PARAM[level]</pagecontrol>
				<onclick condition="!ListItem.IsFolder">$PARAM[item_click]</onclick>
				<onclick condition="ListItem.IsFolder + $PARAM[last]">ActivateWindow(AddonBrowser,$INFO[Container($PARAM[root]5$PARAM[level]).ListItem.FolderPath],return)</onclick>
				<onclick condition="ListItem.IsFolder + !$PARAM[last] + String.IsEqual(Container($PARAM[root]5$PARAM[level]).ListItem.FolderPath,Window(1100).Property(launcher_$PARAM[root]_path$PARAM[next]))">SetProperty(launcher_$PARAM[root]_label$PARAM[next],"$INFO[Container($PARAM[root]5$PARAM[level]).ListItem.Label]",1100)</onclick>
				<onclick condition="ListItem.IsFolder + !$PARAM[last] + String.IsEqual(Container($PARAM[root]5$PARAM[level]).ListItem.FolderPath,Window(1100).Property(launcher_$PARAM[root]_path$PARAM[next]))">SetProperty(launcher_$PARAM[root]_depth,$PARAM[next],1100)</onclick>
				<onclick condition="ListItem.IsFolder + !$PARAM[last] + String.IsEqual(Container($PARAM[root]5$PARAM[level]).ListItem.FolderPath,Window(1100).Property(launcher_$PARAM[root]_path$PARAM[next]))">SetFocus($PARAM[root]5$PARAM[next])</onclick>
				<onclick condition="ListItem.IsFolder + !$PARAM[last] + !String.IsEqual(Container($PARAM[root]5$PARAM[level]).ListItem.FolderPath,Window(1100).Property(launcher_$PARAM[root]_path$PARAM[next]))">SetProperty(launcher_$PARAM[root]_path$PARAM[flush1],plugin://script.altus.helper/?mode=noop_empty,1100)</onclick>
				<onclick condition="ListItem.IsFolder + !$PARAM[last] + !String.IsEqual(Container($PARAM[root]5$PARAM[level]).ListItem.FolderPath,Window(1100).Property(launcher_$PARAM[root]_path$PARAM[next]))">SetProperty(launcher_$PARAM[root]_path$PARAM[flush2],plugin://script.altus.helper/?mode=noop_empty,1100)</onclick>
				<onclick condition="ListItem.IsFolder + !$PARAM[last] + !String.IsEqual(Container($PARAM[root]5$PARAM[level]).ListItem.FolderPath,Window(1100).Property(launcher_$PARAM[root]_path$PARAM[next]))">SetProperty(launcher_$PARAM[root]_pending,$PARAM[next],1100)</onclick>
				<onclick condition="ListItem.IsFolder + !$PARAM[last] + !String.IsEqual(Container($PARAM[root]5$PARAM[level]).ListItem.FolderPath,Window(1100).Property(launcher_$PARAM[root]_path$PARAM[next]))">AlarmClock(launcher_pending,ClearProperty(launcher_$PARAM[root]_pending,1100),00:00,silent)</onclick>
				<onclick condition="ListItem.IsFolder + !$PARAM[last] + !String.IsEqual(Container($PARAM[root]5$PARAM[level]).ListItem.FolderPath,Window(1100).Property(launcher_$PARAM[root]_path$PARAM[next]))">SetProperty(launcher_hold_art,$INFO[Container($PARAM[root]5$PARAM[level]).ListItem.Art(fanart)],1100)</onclick>
				<onclick condition="ListItem.IsFolder + !$PARAM[last] + !String.IsEqual(Container($PARAM[root]5$PARAM[level]).ListItem.FolderPath,Window(1100).Property(launcher_$PARAM[root]_path$PARAM[next]))">SetProperty(launcher_$PARAM[root]_label$PARAM[next],"$INFO[Container($PARAM[root]5$PARAM[level]).ListItem.Label]",1100)</onclick>
				<onclick condition="ListItem.IsFolder + !$PARAM[last] + !String.IsEqual(Container($PARAM[root]5$PARAM[level]).ListItem.FolderPath,Window(1100).Property(launcher_$PARAM[root]_path$PARAM[next]))">SetProperty(launcher_$PARAM[root]_depth,$PARAM[next],1100)</onclick>
				<onclick condition="ListItem.IsFolder + !$PARAM[last] + !String.IsEqual(Container($PARAM[root]5$PARAM[level]).ListItem.FolderPath,Window(1100).Property(launcher_$PARAM[root]_path$PARAM[next]))">SetFocus($PARAM[root]5$PARAM[next],0,absolute)</onclick>
				<onclick condition="ListItem.IsFolder + !$PARAM[last] + !String.IsEqual(Container($PARAM[root]5$PARAM[level]).ListItem.FolderPath,Window(1100).Property(launcher_$PARAM[root]_path$PARAM[next]))">AlarmClock(launcher_refocus,SetFocus($PARAM[root]5$PARAM[next],0,absolute),00:00,silent)</onclick>
				<onclick condition="ListItem.IsFolder + !$PARAM[last] + !String.IsEqual(Container($PARAM[root]5$PARAM[level]).ListItem.FolderPath,Window(1100).Property(launcher_$PARAM[root]_path$PARAM[next]))">SetProperty(launcher_$PARAM[root]_path$PARAM[next],$INFO[Container($PARAM[root]5$PARAM[level]).ListItem.FolderPath],1100)</onclick>
				<onback>ClearProperty(launcher_$PARAM[root]_pending,1100)</onback>
				<onback>ClearProperty(launcher_$PARAM[root]_label$PARAM[level],1100)</onback>
				<onback>$PARAM[back_depth]</onback>
				<onback condition="$PARAM[back_has_items]">$PARAM[back_id]</onback>
				<onback>9000</onback>
				<itemlayout width="712" height="159" infoupdate="30">
					<include content="AddonLauncherTile">
						<param name="list_id" value="$PARAM[root]5$PARAM[level]"/>
						<param name="sublabel" value="$PARAM[sublabel]"/>
						<param name="has_sublabel" value="$PARAM[has_sublabel]"/>
					</include>
				</itemlayout>
				<focusedlayout width="712" height="159" infoupdate="30">
					<control type="group">
						<depth>DepthContentPopout</depth>
						<include content="AddonLauncherTile">
							<param name="list_id" value="$PARAM[root]5$PARAM[level]"/>
							<param name="focused" value="true"/>
							<param name="sublabel" value="$PARAM[sublabel]"/>
							<param name="has_sublabel" value="$PARAM[has_sublabel]"/>
						</include>
						<include>FocusBounce</include>
					</control>
				</focusedlayout>
				<content sortby="$PARAM[sortby]" sortorder="$PARAM[sortorder]" target="$PARAM[target]">$PARAM[content]</content>
			</control>
			<control type="scrollbar" id="$PARAM[root]3$PARAM[level]">
				<left>1421</left>
				<top>18</top>
				<width>12</width>
				<height>917</height>
				<orientation>vertical</orientation>
				<texturesliderbackground />
				<animation effect="slide" end="6,0" time="300" tween="sine" easing="inout" condition="!Control.HasFocus($PARAM[root]3$PARAM[level])">conditional</animation>
				<onleft>$PARAM[root]5$PARAM[level]</onleft>
				<onright>noop</onright>
				<onback>$PARAM[root]5$PARAM[level]</onback>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<include name="AddonLauncherHeader">
		<definition>
			<control type="group">
				<left>18</left>
				<top>18</top>
				<width>1387</width>
				<height>122</height>
				<control type="image">
					<texture border="33" colordiffuse="4D000000">masks/radius_33.png</texture>
				</control>
				<control type="image">
					<left>35</left>
					<centertop>50%</centertop>
					<width>60</width>
					<height>60</height>
					<texture colordiffuse="unfocused_text">$INFO[Container(9000).ListItem.Property(icon)]</texture>
					<aspectratio>keep</aspectratio>
					<animation effect="fade" start="100" end="30" time="500" tween="sine" easing="inout" pulse="true" condition="$PARAM[loading]">Conditional</animation>
				</control>
				<control type="label">
					<left>133</left>
					<width>1223</width>
					<height>122</height>
					<aligny>center</aligny>
					<font>font37_title</font>
					<textcolor>$VAR[FocusColorTheme]</textcolor>
					<label>[COLOR unfocused_text]root[/COLOR] /$INFO[Window(1100).Property(launcher_$PARAM[root]_label1), [COLOR unfocused_text],[/COLOR]]$INFO[Window(1100).Property(launcher_$PARAM[root]_label2), / [COLOR unfocused_text],[/COLOR]]$INFO[Window(1100).Property(launcher_$PARAM[root]_label3), / [COLOR unfocused_text],[/COLOR]]</label>
				</control>
			</control>
		</definition>
	</include>

	<include name="AddonLauncherWall">
		<param name="sortby">label</param>
		<param name="sortorder">ascending</param>
		<definition>
			<include content="AddonLauncherHeader">
				<param name="root" value="$PARAM[root]"/>
				<param name="loading" value="[[String.IsEmpty(Window(1100).Property(launcher_$PARAM[root]_depth)) + Container($PARAM[root]50).IsUpdating] | [String.IsEqual(Window(1100).Property(launcher_$PARAM[root]_depth),1) + Container($PARAM[root]51).IsUpdating] | [String.IsEqual(Window(1100).Property(launcher_$PARAM[root]_depth),2) + Container($PARAM[root]52).IsUpdating] | [String.IsEqual(Window(1100).Property(launcher_$PARAM[root]_depth),3) + Container($PARAM[root]53).IsUpdating]]"/>
			</include>
			<include content="AddonLauncherPanel">
				<param name="root" value="$PARAM[root]"/>
				<param name="item_click" value="$PARAM[item_click]"/>
				<param name="target" value="$PARAM[target]"/>
				<param name="sublabel" value="$PARAM[sublabel]"/>
				<param name="has_sublabel" value="$PARAM[has_sublabel]"/>
				<param name="level" value="0"/>
				<param name="next" value="1"/>
				<param name="flush1" value="2"/>
				<param name="flush2" value="3"/>
				<param name="visible" value="String.IsEmpty(Window(1100).Property(launcher_$PARAM[root]_depth))"/>
				<param name="hold" value="String.IsEqual(Window(1100).Property(launcher_$PARAM[root]_depth),1) + [String.IsEqual(Window(1100).Property(launcher_$PARAM[root]_pending),1) | Container($PARAM[root]51).IsUpdating]"/>
				<param name="content" value="$PARAM[root_path]"/>
				<param name="sortby" value="$PARAM[sortby]"/>
				<param name="sortorder" value="$PARAM[sortorder]"/>
				<param name="back_depth" value="ClearProperty(launcher_$PARAM[root]_depth,1100)"/>
				<param name="back_id" value="9000"/>
			</include>
			<include content="AddonLauncherPanel">
				<param name="root" value="$PARAM[root]"/>
				<param name="item_click" value="$PARAM[item_click]"/>
				<param name="target" value="$PARAM[target]"/>
				<param name="sublabel" value="$PARAM[sublabel]"/>
				<param name="has_sublabel" value="$PARAM[has_sublabel]"/>
				<param name="level" value="1"/>
				<param name="next" value="2"/>
				<param name="flush1" value="3"/>
				<param name="flush2" value="4"/>
				<param name="visible" value="String.IsEqual(Window(1100).Property(launcher_$PARAM[root]_depth),1)"/>
				<param name="hold" value="String.IsEqual(Window(1100).Property(launcher_$PARAM[root]_depth),2) + [String.IsEqual(Window(1100).Property(launcher_$PARAM[root]_pending),2) | Container($PARAM[root]52).IsUpdating]"/>
				<param name="content" value="$INFO[Window(1100).Property(launcher_$PARAM[root]_path1)]"/>
				<param name="back_depth" value="ClearProperty(launcher_$PARAM[root]_depth,1100)"/>
				<param name="back_id" value="$PARAM[root]50"/>
				<param name="back_has_items" value="Integer.IsGreater(Container($PARAM[root]50).NumItems,0)"/>
			</include>
			<include content="AddonLauncherPanel">
				<param name="root" value="$PARAM[root]"/>
				<param name="item_click" value="$PARAM[item_click]"/>
				<param name="target" value="$PARAM[target]"/>
				<param name="sublabel" value="$PARAM[sublabel]"/>
				<param name="has_sublabel" value="$PARAM[has_sublabel]"/>
				<param name="level" value="2"/>
				<param name="next" value="3"/>
				<param name="flush1" value="4"/>
				<param name="flush2" value="5"/>
				<param name="visible" value="String.IsEqual(Window(1100).Property(launcher_$PARAM[root]_depth),2)"/>
				<param name="hold" value="String.IsEqual(Window(1100).Property(launcher_$PARAM[root]_depth),3) + [String.IsEqual(Window(1100).Property(launcher_$PARAM[root]_pending),3) | Container($PARAM[root]53).IsUpdating]"/>
				<param name="content" value="$INFO[Window(1100).Property(launcher_$PARAM[root]_path2)]"/>
				<param name="back_depth" value="SetProperty(launcher_$PARAM[root]_depth,1,1100)"/>
				<param name="back_id" value="$PARAM[root]51"/>
				<param name="back_has_items" value="Integer.IsGreater(Container($PARAM[root]51).NumItems,0)"/>
			</include>
			<include content="AddonLauncherPanel">
				<param name="root" value="$PARAM[root]"/>
				<param name="item_click" value="$PARAM[item_click]"/>
				<param name="target" value="$PARAM[target]"/>
				<param name="sublabel" value="$PARAM[sublabel]"/>
				<param name="has_sublabel" value="$PARAM[has_sublabel]"/>
				<param name="level" value="3"/>
				<param name="next" value="4"/>
				<param name="flush1" value="5"/>
				<param name="flush2" value="6"/>
				<param name="last" value="true"/>
				<param name="visible" value="String.IsEqual(Window(1100).Property(launcher_$PARAM[root]_depth),3)"/>
				<param name="content" value="$INFO[Window(1100).Property(launcher_$PARAM[root]_path3)]"/>
				<param name="back_depth" value="SetProperty(launcher_$PARAM[root]_depth,2,1100)"/>
				<param name="back_id" value="$PARAM[root]52"/>
				<param name="back_has_items" value="Integer.IsGreater(Container($PARAM[root]52).NumItems,0)"/>
			</include>
		</definition>
	</include>

	<include name="AddonLauncherRoot">
		<definition>
			<control type="group" id="$PARAM[root]">
				<left>487</left>
				<top>76</top>
				<include content="Visible_Right_Delayed">
					<param name="id" value="$PARAM[id]"/>
				</include>
				<visible>String.IsEqual(Container(9000).ListItem.Property(id),$PARAM[id])</visible>
				<include content="AddonLauncherWall">
					<param name="root" value="$PARAM[root]"/>
					<param name="root_path" value="$PARAM[root_path]"/>
					<param name="sortby" value="$PARAM[sortby]"/>
					<param name="sortorder" value="$PARAM[sortorder]"/>
					<param name="item_click" value="$PARAM[item_click]"/>
					<param name="target" value="$PARAM[target]"/>
					<param name="sublabel" value="$PARAM[sublabel]"/>
					<param name="has_sublabel" value="$PARAM[has_sublabel]"/>
				</include>
			</control>
		</definition>
	</include>

	<include name="AddonLauncherMenuRight">
		<definition>
			<onright condition="String.IsEqual(Container(9000).ListItem.Property(menu_id),$PARAM[root]) + String.IsEqual(Window(1100).Property(launcher_$PARAM[root]_depth),3) + Integer.IsGreater(Container($PARAM[root]53).NumItems,0)">SetFocus($PARAM[root]53)</onright>
			<onright condition="String.IsEqual(Container(9000).ListItem.Property(menu_id),$PARAM[root]) + [[String.IsEqual(Window(1100).Property(launcher_$PARAM[root]_depth),2) + Integer.IsGreater(Container($PARAM[root]52).NumItems,0)] | [String.IsEqual(Window(1100).Property(launcher_$PARAM[root]_depth),3) + !Integer.IsGreater(Container($PARAM[root]53).NumItems,0) + Integer.IsGreater(Container($PARAM[root]52).NumItems,0)]]">SetProperty(launcher_$PARAM[root]_depth,2,1100)</onright>
