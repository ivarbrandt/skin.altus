		<animation condition="Skin.HasSetting(HomeWalls.ManualLoading) + Control.HasFocus($PARAM[row_id]) + [[String.IsEmpty(Window(Home).Property(altus_wall_$PARAM[row_id])) + !String.IsEqual(Container($PARAM[row_id]).ListItemAbsolute(0).Property(wall_id),Container($PARAM[row_id]).ListItem.Property(wall_id))] | [!String.IsEmpty(Window(Home).Property(altus_wall_$PARAM[row_id])) + !String.IsEqual(Window(Home).Property(altus_wall_$PARAM[row_id]),Container($PARAM[row_id]).ListItem.Property(wall_id))]] + String.IsEqual(Skin.String(BackgroundSetting),1)" reversible="true">
			<effect type="fadediffuse" start="FFFFFFFF" end="FF777777" time="300" />
		</animation>
		<animation condition="Skin.HasSetting(HomeWalls.ManualLoading) + Control.HasFocus($PARAM[row_id]) + [[String.IsEmpty(Window(Home).Property(altus_wall_$PARAM[row_id])) + !String.IsEqual(Container($PARAM[row_id]).ListItemAbsolute(0).Property(wall_id),Container($PARAM[row_id]).ListItem.Property(wall_id))] | [!String.IsEmpty(Window(Home).Property(altus_wall_$PARAM[row_id])) + !String.IsEqual(Window(Home).Property(altus_wall_$PARAM[row_id]),Container($PARAM[row_id]).ListItem.Property(wall_id))]] + [String.IsEqual(Skin.String(BackgroundSetting),0) | String.IsEqual(Skin.String(BackgroundSetting),2)]" reversible="true">
			<effect type="fade" start="100" end="50" time="300" tween="sine" easing="inout" />
		</animation>
	</include>

	<include name="HomeWallCommon">
		<visible allowhiddenfocus="true">$PARAM[visible]</visible>
		<animation effect="fade" time="300">Visible</animation>
		<left>0</left>
		<top>0</top>
		<width>1424</width>
		<height>1008</height>
		<orientation>vertical</orientation>
		<scrolltime tween="cubic" easing="out">600</scrolltime>
		<preloaditems>1</preloaditems>
		<onup>SetFocus($PARAM[list_id],0,absolute)</onup>
		<onup condition="!Integer.IsEqual(Container($PARAM[row_id]).NumItems,1)">SetFocus($PARAM[row_id])</onup>
		<onup condition="Integer.IsEqual(Container($PARAM[row_id]).NumItems,1)">9000</onup>
		<onleft condition="!String.IsEqual(Skin.String(onLeftSetting.Home),1)">9000</onleft>
		<onleft condition="String.IsEqual(Skin.String(onLeftSetting.Home),1)">$PARAM[list_id]</onleft>
		<onright>$PARAM[list_id]</onright>
		<onback condition="Player.HasMedia + !String.IsEmpty(Skin.String(TrailerPlaying))">Stop</onback>
		<onback>SetFocus($PARAM[list_id],0,absolute)</onback>
		<onback condition="!String.IsEqual(Skin.String(onBackSetting.Home),1) + !Integer.IsEqual(Container($PARAM[row_id]).NumItems,1)">$PARAM[row_id]</onback>
		<onback condition="String.IsEqual(Skin.String(onBackSetting.Home),1) | Integer.IsEqual(Container($PARAM[row_id]).NumItems,1)">9000</onback>
		<onfocus condition="Skin.HasSetting(HomeWalls.ManualLoading)">SetProperty(altus_wall_$PARAM[row_id],$PARAM[list_id],home)</onfocus>
		<onunfocus condition="Player.HasMedia + !String.IsEmpty(Skin.String(TrailerPlaying))">Stop</onunfocus>
		<onunfocus condition="!String.IsEmpty(Skin.String(TrailerPlaying))">Skin.Reset(TrailerPlaying)</onunfocus>
	</include>

	<include name="HomeWallUnfocusedAnimations">
		<animation condition="Skin.HasSetting(Enable.HomeWallsDim) + Control.HasFocus($PARAM[list_id]) + String.IsEqual(Skin.String(BackgroundSetting),1)" reversible="true">
