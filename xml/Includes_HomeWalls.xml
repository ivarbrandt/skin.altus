	<include name="HomeWallTabIndicators">
		<param name="top">83</param>
		<param name="left">20</param>
		<param name="right">1342</param>
		<definition>
			<control type="group">
				<animation effect="fade" start="100" end="0" time="300" tween="sine" easing="inout" condition="ControlGroup($PARAM[section_id]).HasFocus + !Control.HasFocus($PARAM[row_id])">Conditional</animation>
				<control type="image">
					<left>$PARAM[left]</left>
					<top>$PARAM[top]</top>
					<width>68</width>
					<height>87</height>
					<texture border="0,33,0,33" colordiffuse="$VAR[FocusColorTheme]">masks/tabrow_divider.png</texture>
					<animation effect="zoom" start="100,0" end="100,100" center="auto" delay="100" time="300">Visible</animation>
					<animation effect="fade" start="0" end="100" delay="100" time="300">Visible</animation>
					<animation effect="fade" start="100" end="0" time="0">Hidden</animation>
					<visible>Container($PARAM[row_id]).HasPrevious + !Container($PARAM[row_id]).OnScrollNext + !Container($PARAM[row_id]).OnScrollPrevious</visible>
				</control>
				<control type="image">
					<left>$PARAM[right]</left>
					<top>$PARAM[top]</top>
					<width>68</width>
					<height>87</height>
					<texture flipx="true" border="0,33,0,33" colordiffuse="$VAR[FocusColorTheme]">masks/tabrow_divider.png</texture>
					<animation effect="zoom" start="100,0" end="100,100" center="auto" delay="100" time="300">Visible</animation>
					<animation effect="fade" start="0" end="100" delay="100" time="300">Visible</animation>
					<animation effect="fade" start="100" end="0" time="0">Hidden</animation>
					<visible>Container($PARAM[row_id]).HasNext + !Container($PARAM[row_id]).OnScrollNext + !Container($PARAM[row_id]).OnScrollPrevious</visible>
				</control>
			</control>
		</definition>
	</include>

	<include name="HomeWallTabLayout">
		<param name="focused">false</param>
		<definition>
			<control type="group">
				<top>26</top>
				<left>20</left>
				<width>322</width>
				<height>87</height>
				<control type="image">
					<texture border="33" colordiffuse="4D000000">masks/radius_33.png</texture>
				</control>
				<control type="image">
					<texture border="33" colordiffuse="80000000">masks/radius_33.png</texture>
					<visible>!ControlGroup($PARAM[walls_id]).HasFocus + ![$PARAM[focused] + Control.HasFocus($PARAM[row_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[row_id]).CurrentItem)]</visible>
					<visible>[!Skin.HasSetting(HomeWalls.ManualLoading) + $PARAM[focused]] | [Skin.HasSetting(HomeWalls.ManualLoading) + [String.IsEqual(Window(Home).Property(altus_wall_$PARAM[row_id]),ListItem.Property(wall_id)) | [$PARAM[fallback] + Integer.IsEqual(ListItem.CurrentItem,1)]]]</visible>
				</control>
				<control type="image">
					<texture border="33" colordiffuse="80000000">masks/radius_33.png</texture>
					<visible>[$PARAM[focused] + Control.HasFocus($PARAM[row_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[row_id]).CurrentItem)] | [$PARAM[focused] + ControlGroup($PARAM[walls_id]).HasFocus]</visible>
				</control>
				<include content="FocusBorder">
					<param name="list_id" value="$PARAM[row_id]"/>
					<param name="focused" value="$PARAM[focused]"/>
					<param name="radius" value="33"/>
					<param name="border" value="33"/>
					<param name="extra" value="ControlGroup($PARAM[walls_id]).HasFocus"/>
				</include>
				<control type="textbox">
					<centertop>50%</centertop>
					<left>20</left>
					<right>20</right>
					<height>87</height>
					<align>center</align>
					<aligny>center</aligny>
					<label>$VAR[MenuCaseVar]</label>
					<textcolor>$VAR[FocusColorTheme]</textcolor>
					<font>font27_title</font>
					<autoscroll delay="2000" time="3000" repeat="2000">Control.HasFocus($PARAM[row_id])</autoscroll>
					<visible>[$PARAM[focused] + Control.HasFocus($PARAM[row_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[row_id]).CurrentItem)] | [$PARAM[focused] + ControlGroup($PARAM[walls_id]).HasFocus] | [!ControlGroup($PARAM[walls_id]).HasFocus + [[!Skin.HasSetting(HomeWalls.ManualLoading) + $PARAM[focused] + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[row_id]).CurrentItem)] | [Skin.HasSetting(HomeWalls.ManualLoading) + [String.IsEqual(Window(Home).Property(altus_wall_$PARAM[row_id]),ListItem.Property(wall_id)) | [$PARAM[fallback] + Integer.IsEqual(ListItem.CurrentItem,1)]]]]]</visible>
				</control>
				<control type="textbox">
					<centertop>50%</centertop>
					<left>20</left>
					<right>20</right>
					<height>87</height>
					<align>center</align>
					<aligny>center</aligny>
					<label>$VAR[MenuCaseVar]</label>
					<textcolor>unfocused_text</textcolor>
					<font>font27_title</font>
					<visible>![[$PARAM[focused] + Control.HasFocus($PARAM[row_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[row_id]).CurrentItem)] | [$PARAM[focused] + ControlGroup($PARAM[walls_id]).HasFocus] | [!ControlGroup($PARAM[walls_id]).HasFocus + [[!Skin.HasSetting(HomeWalls.ManualLoading) + $PARAM[focused] + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[row_id]).CurrentItem)] | [Skin.HasSetting(HomeWalls.ManualLoading) + [String.IsEqual(Window(Home).Property(altus_wall_$PARAM[row_id]),ListItem.Property(wall_id)) | [$PARAM[fallback] + Integer.IsEqual(ListItem.CurrentItem,1)]]]]]]</visible>
