		</animation>
		<animation condition="Skin.HasSetting(Enable.HomeWallsDim) + Control.HasFocus($PARAM[list_id]) + [String.IsEqual(Skin.String(BackgroundSetting),0) | String.IsEqual(Skin.String(BackgroundSetting),2)]" reversible="true">
			<effect type="fade" start="100" end="50" time="300" tween="sine" easing="inout" />
		</animation>
	</include>

	<include name="HomeWallFocusAnimations">
		<animation type="Focus" condition="Skin.HasSetting(Enable.HomeWallsDim) + Control.HasFocus($PARAM[list_id]) + String.IsEqual(Skin.String(BackgroundSetting),1)" reversible="false">
			<effect type="fadediffuse" start="FF777777" end="FFFFFFFF" time="300" />
		</animation>
		<animation type="Unfocus" condition="Skin.HasSetting(Enable.HomeWallsDim) + Control.HasFocus($PARAM[list_id]) + String.IsEqual(Skin.String(BackgroundSetting),1)" reversible="false">
			<effect type="fadediffuse" start="FFFFFFFF" end="FF777777" time="300" />
		</animation>
		<animation type="Focus" condition="Skin.HasSetting(Enable.HomeWallsDim) + Control.HasFocus($PARAM[list_id]) + [String.IsEqual(Skin.String(BackgroundSetting),0) | String.IsEqual(Skin.String(BackgroundSetting),2)]" reversible="false">
			<effect type="fade" start="50" end="100" time="300" tween="sine" easing="inout" />
		</animation>
		<animation type="Unfocus" condition="Skin.HasSetting(Enable.HomeWallsDim) + Control.HasFocus($PARAM[list_id]) + [String.IsEqual(Skin.String(BackgroundSetting),0) | String.IsEqual(Skin.String(BackgroundSetting),2)]" reversible="false">
			<effect type="fade" start="100" end="50" time="300" tween="sine" easing="inout" />
		</animation>
	</include>

