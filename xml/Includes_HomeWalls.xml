		<width>1424</width>
		<height>140</height>
		<orientation>horizontal</orientation>
		<focusposition>0</focusposition>
		<movement>3</movement>
		<scrolltime tween="cubic" easing="out">400</scrolltime>
		<onfocus>ClearProperty(FeatureWidgetFocused,Home)</onfocus>
		<onfocus condition="Integer.IsEqual(Container($PARAM[row_id]).NumItems,1)">SetFocus($INFO[Container($PARAM[row_id]).ListItem.Property(wall_id)],0,absolute)</onfocus>
		<onleft>9000</onleft>
		<onright>$PARAM[row_id]</onright>
		<onup>$PARAM[row_id]</onup>
		<ondown condition="Skin.HasSetting(HomeWalls.ManualLoading)">SetProperty(altus_wall_$PARAM[row_id],$INFO[Container($PARAM[row_id]).ListItem.Property(wall_id)],home)</ondown>		<ondown>SetFocus($INFO[Container($PARAM[row_id]).ListItem.Property(wall_id)],0,absolute)</ondown>
		<onback>9000</onback>
		<animation effect="fade" start="100" end="0" time="300" tween="sine" easing="inout" condition="ControlGroup($PARAM[walls_id]).HasFocus">Conditional</animation>
