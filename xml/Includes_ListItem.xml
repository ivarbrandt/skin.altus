<?xml version="1.0" encoding="UTF-8"?>
<includes>

  <include name="List">
    <param name="height">85</param>
    <definition>
      <focusedlayout height="$PARAM[height]" infoupdate="30">
        <control type="group">
          <animation effect="fade" start="100" end="0" time="0">UnFocus</animation>
        </control>
        <include content="ListItem">
          <param name="id" value="$PARAM[id]" />
          <param name="focused" value="true" />
          <param name="list_width" value="$PARAM[list_width]" />
          <param name="align" value="$PARAM[align]" />
          <param name="left_right_text" value="$PARAM[left_right_text]" />
          <param name="img_top" value="$PARAM[img_top]" />
          <param name="img_bottom" value="$PARAM[img_bottom]" />
          <param name="img_width" value="$PARAM[img_width]" />
          <param name="img_left" value="$PARAM[img_left]" />
          <param name="img_texture" value="$PARAM[img_texture]" />
          <param name="focused_text" value="$PARAM[focused_text]" />
          <param name="focused_font" value="$PARAM[focused_font]" />
        </include>
      </focusedlayout>
      <itemlayout height="$PARAM[height]">
        <include content="ListItem">
          <param name="id" value="$PARAM[id]" />
          <param name="list_width" value="$PARAM[list_width]" />
          <param name="align" value="$PARAM[align]" />
          <param name="left_right_text" value="$PARAM[left_right_text]" />
          <param name="unfocused_font" value="$PARAM[unfocused_font]" />
        </include>
      </itemlayout>
    </definition>
  </include>

  <include name="SearchList">
    <!-- Search-history row list. Reads:
         ListItem.Label                     the search term
         ListItem.Property(count)           cumulative search count
         ListItem.Property(last)            humanized "X ago" timestamp -->
    <param name="height">168</param>
    <definition>
      <focusedlayout height="$PARAM[height]" infoupdate="30">
        <control type="group">
          <animation effect="fade" start="100" end="0" time="0">UnFocus</animation>
        </control>
        <include content="SearchItem">
          <param name="id" value="$PARAM[id]" />
          <param name="focused" value="true" />
        </include>
      </focusedlayout>
      <itemlayout height="$PARAM[height]">
        <include content="SearchItem">
          <param name="id" value="$PARAM[id]" />
        </include>
      </itemlayout>
    </definition>
  </include>

  <include name="SearchItem">
    <param name="focused">false</param>
    <param name="main_font_focused">font37_title</param>
    <param name="main_font_unfocused">font37_title</param>
    <param name="sub_font">font23_title</param>
    <definition>
      <control type="group">
        <control type="image">
          <top>18</top>
          <bottom>19</bottom>
          <left>0</left>
          <right>0</right>
          <texture border="46" colordiffuse="4D000000">masks/radius_46.png</texture>
          <visible>![$PARAM[focused] + Control.HasFocus($PARAM[id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)]</visible>
        </control>
        <control type="image">
          <top>18</top>
          <bottom>19</bottom>
          <left>0</left>
          <right>0</right>
          <texture border="46" colordiffuse="A6000000">masks/radius_46.png</texture>
          <visible>$PARAM[focused] + Control.HasFocus($PARAM[id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)</visible>
        </control>
        <include content="FocusBorder">
          <param name="list_id" value="$PARAM[id]"/>
          <param name="focused" value="$PARAM[focused]"/>
          <param name="radius" value="46_alt"/>
          <param name="border" value="46"/>
          <param name="top" value="18"/>
          <param name="bottom" value="19"/>
        </include>
        <!-- Main label - unfocused -->
        <control type="label">
          <left>37</left>
          <right>37</right>
          <top>50</top>
          <height>32</height>
          <aligny>center</aligny>
          <font>$PARAM[main_font_unfocused]</font>
          <textcolor>unfocused_text</textcolor>
          <shadowcolor>text_shadow</shadowcolor>
          <label>$INFO[ListItem.Label]</label>
          <visible>![$PARAM[focused] + Control.HasFocus($PARAM[id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)]</visible>
        </control>
        <!-- Main label - focused -->
        <control type="label">
          <left>37</left>
          <right>37</right>
          <top>50</top>
          <height>32</height>
          <aligny>center</aligny>
          <font>$PARAM[main_font_focused]</font>
          <textcolor>$VAR[FocusColorTheme]</textcolor>
          <shadowcolor>text_shadow</shadowcolor>
          <label>$INFO[ListItem.Label]</label>
          <visible>$PARAM[focused] + Control.HasFocus($PARAM[id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)</visible>
          <scroll>$PARAM[focused]</scroll>
          <scrollspeed>150</scrollspeed>
        </control>
        <!-- Sub label - unfocused -->
        <control type="label">
          <left>37</left>
          <right>37</right>
          <top>95</top>
          <height>22</height>
          <aligny>center</aligny>
          <font>$PARAM[sub_font]</font>
          <textcolor>unfocused_text</textcolor>
          <shadowcolor>text_shadow</shadowcolor>
          <label>$INFO[ListItem.Property(count),Searches: ,  •  ]$INFO[ListItem.Property(last)]</label>
          <visible>![$PARAM[focused] + Control.HasFocus($PARAM[id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)]</visible>
        </control>
        <!-- Sub label - focused -->
        <control type="label">
          <left>37</left>
          <right>37</right>
          <top>95</top>
          <height>22</height>
          <aligny>center</aligny>
          <font>$PARAM[sub_font]</font>
          <textcolor>$VAR[FocusColorTheme]</textcolor>
          <shadowcolor>text_shadow</shadowcolor>
          <label>$INFO[ListItem.Property(count),Searches: ,  •  ]$INFO[ListItem.Property(last)]</label>
          <visible>$PARAM[focused] + Control.HasFocus($PARAM[id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)</visible>
        </control>
      </control>
    </definition>
  </include>

  <include name="MainMenuList">
    <param name="height">140</param>
    <param name="img_top">18</param>
    <param name="img_bottom">19</param>
    <definition>
      <focusedlayout height="$PARAM[height]" infoupdate="30">
        <control type="group">
          <animation effect="fade" start="100" end="0" time="0">UnFocus</animation>
        </control>
        <include content="MainMenuListItem">
          <param name="id" value="$PARAM[id]" />
          <param name="focused" value="true" />
          <param name="list_width" value="$PARAM[list_width]" />
          <param name="align" value="$PARAM[align]" />
          <param name="left_right_text" value="$PARAM[left_right_text]" />
          <param name="img_top" value="$PARAM[img_top]" />
          <param name="img_bottom" value="$PARAM[img_bottom]" />
          <param name="img_width" value="$PARAM[img_width]" />
          <param name="img_left" value="$PARAM[img_left]" />
          <param name="img_texture" value="$PARAM[img_texture]" />
          <param name="focused_text" value="$PARAM[focused_text]" />
          <param name="focused_icon" value="$PARAM[focused_icon]" />
          <param name="active" value="$PARAM[active]" />
          <param name="focused_font" value="$PARAM[focused_font]" />
