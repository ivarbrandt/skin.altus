  <include name="MenuScrollIndicators">
    <param name="top">196</param>
    <param name="bottom">900</param>
    <param name="width">428</param>
    <definition>
      <control type="image">
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>94</height>
        <texture flipy="true" border="46,0,46,0" colordiffuse="$VAR[FocusColorTheme]">masks/mainmenu_divider.png</texture>
        <animation effect="zoom" start="0,100" end="100,100" center="auto" delay="100" time="300">Visible</animation>
        <animation effect="fade" start="0" end="100" delay="100" time="300">Visible</animation>
        <animation effect="fade" start="100" end="0" time="0">Hidden</animation>
        <visible>Container($PARAM[list_id]).HasPrevious + !Container($PARAM[list_id]).OnScrollNext + !Container($PARAM[list_id]).OnScrollPrevious</visible>
      </control>
      <control type="group">
        <top>$PARAM[bottom]</top>
        <control type="image">
          <top>9</top>
          <width>$PARAM[width]</width>
          <height>94</height>
          <texture border="46,0,46,0" colordiffuse="$VAR[FocusColorTheme]">masks/mainmenu_divider.png</texture>
          <animation effect="zoom" start="0,100" end="100,100" center="auto" delay="100" time="300">Visible</animation>
          <animation effect="fade" start="0" end="100" delay="100" time="300">Visible</animation>
          <animation effect="fade" start="100" end="0" time="0">Hidden</animation>
          <visible>Container($PARAM[list_id]).HasNext + !Container($PARAM[list_id]).OnScrollNext + !Container($PARAM[list_id]).OnScrollPrevious</visible>
        </control>
      </control>
    </definition>
  </include>

  <include name="CastItem">
    <definition>
      <itemlayout width="540" height="135">
        <include content="ListItemTwoLine">
          <param name="id" value="$PARAM[id]" />
          <param name="MainLabel" value="$PARAM[MainLabel]" />
          <param name="SubLabel" value="$PARAM[SubLabel]" />
        </include>
      </itemlayout>
      <focusedlayout width="540" height="135">
        <include content="ListItemTwoLine">
          <param name="id" value="$PARAM[id]" />
          <param name="focused" value="true" />
          <param name="MainLabel" value="$PARAM[MainLabel]" />
          <param name="SubLabel" value="$PARAM[SubLabel]" />
        </include>
      </focusedlayout>
    </definition>
  </include>

