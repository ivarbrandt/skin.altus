  <include name="MainMenuListItem">
    <param name="focused">false</param>
    <param name="img_top">18</param>
    <param name="img_bottom">19</param>
    <param name="align">left</param>
    <param name="left_right_text">37</param>
    <!-- <param name="img_left">47</param> -->
    <param name="focused_font">font37_title</param>
    <param name="unfocused_font">font37_title</param>
    <param name="img_texture">masks/radius_46.png</param>
    <param name="focused_text">$VAR[FocusColorTheme]</param>
    <param name="focused_icon">$VAR[FocusColorTheme]</param>
    <param name="active">ControlGroup(2000).HasFocus</param>
    <definition>
      <control type="group">
        <control type="image">
          <top>$PARAM[img_top]</top>
          <bottom>$PARAM[img_bottom]</bottom>
          <left>0</left>
          <right>0</right>
          <texture border="46" colordiffuse="4D000000">$PARAM[img_texture]</texture>
          <visible>![[$PARAM[focused] + Control.HasFocus($PARAM[id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)] | [$PARAM[focused] + $PARAM[active]]]</visible>
        </control>
        <control type="image">
          <top>$PARAM[img_top]</top>
          <bottom>$PARAM[img_bottom]</bottom>
          <left>0</left>
          <right>0</right>
          <texture border="46" colordiffuse="A6000000">$PARAM[img_texture]</texture>
          <visible>[$PARAM[focused] + Control.HasFocus($PARAM[id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)] | [$PARAM[focused] + $PARAM[active]]</visible>
        </control>
        <include content="FocusBorder">
          <param name="list_id" value="$PARAM[id]"/>
          <param name="focused" value="$PARAM[focused]"/>
          <param name="radius" value="46_alt"/>
          <param name="border" value="46"/>
          <param name="extra" value="$PARAM[active]"/>
          <param name="top" value="$PARAM[img_top]"/>
          <param name="bottom" value="$PARAM[img_bottom]"/>
        </include>
        <control type="group">
          <top>$PARAM[img_top]</top>
          <!-- Section icon -->
          <control type="image">
            <left>32</left>
            <top>28</top>
            <width>47</width>
            <height>47</height>
            <texture diffuse="masks/mainmenu-img.png" colordiffuse="unfocused_text">$VAR[HomeMenuIcon]</texture>
            <aspectratio>keep</aspectratio>
            <visible>[!String.IsEmpty(ListItem.Property(icon)) | String.IsEqual(ListItem.Property(id),weather)] + ![String.IsEqual(ListItem.Property(id),weather) + !Weather.IsFetched] + ![[Control.HasFocus($PARAM[id]) + $PARAM[focused] + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)] | [$PARAM[focused] + $PARAM[active]]]</visible>
          </control>
          <control type="image">
            <left>32</left>
            <top>28</top>
            <width>47</width>
            <height>47</height>
            <texture diffuse="masks/mainmenu-img.png" colordiffuse="$PARAM[focused_icon]">$VAR[HomeMenuIcon]</texture>
            <aspectratio>keep</aspectratio>
            <visible>[!String.IsEmpty(ListItem.Property(icon)) | String.IsEqual(ListItem.Property(id),weather)] + ![String.IsEqual(ListItem.Property(id),weather) + !Weather.IsFetched] + [[Control.HasFocus($PARAM[id]) + $PARAM[focused] + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)] | [$PARAM[focused] + $PARAM[active]]]</visible>
          </control>
          <!-- Weather placeholder icon (before weather fetched) -->
          <control type="image">
            <left>32</left>
            <top>28</top>
            <width>47</width>
            <height>47</height>
            <texture diffuse="masks/mainmenu-img.png" colordiffuse="unfocused_text">icons/weather/cloudy.png</texture>
            <aspectratio>keep</aspectratio>
            <visible>String.IsEqual(ListItem.Property(id),weather) + !Weather.IsFetched + ![[Control.HasFocus($PARAM[id]) + $PARAM[focused] + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)] | [$PARAM[focused] + $PARAM[active]]]</visible>
          </control>
          <control type="image">
            <left>32</left>
            <top>28</top>
            <width>47</width>
            <height>47</height>
            <texture diffuse="masks/mainmenu-img.png" colordiffuse="$PARAM[focused_icon]">icons/weather/cloudy.png</texture>
            <aspectratio>keep</aspectratio>
            <visible>String.IsEqual(ListItem.Property(id),weather) + !Weather.IsFetched + [[Control.HasFocus($PARAM[id]) + $PARAM[focused] + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)] | [$PARAM[focused] + $PARAM[active]]]</visible>
          </control>
        </control>
        <control type="group">
          <visible>String.IsEmpty(ListItem.Property(icon)) + !String.IsEqual(ListItem.Property(id),weather)</visible>
          <control type="label">
            <left>$PARAM[left_right_text]</left>
            <right>$PARAM[left_right_text]</right>
            <aligny>center</aligny>
            <font>$PARAM[unfocused_font]</font>
            <textcolor>unfocused_text</textcolor>
            <label>$VAR[MenuCaseVar]</label>
            <align>$PARAM[align]</align>
            <shadowcolor>text_shadow</shadowcolor>
            <visible>![[Control.HasFocus($PARAM[id]) + $PARAM[focused] + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)] | [$PARAM[focused] + $PARAM[active]]]</visible>
          </control>
          <control type="label">
            <left>$PARAM[left_right_text]</left>
            <right>$PARAM[left_right_text]</right>
            <aligny>center</aligny>
            <font>$PARAM[focused_font]</font>
            <label>$VAR[MenuCaseVar]</label>
            <textcolor>$PARAM[focused_text]</textcolor>
            <align>$PARAM[align]</align>
            <!-- <textcolor>FFFFFFFF</textcolor> -->
            <shadowcolor>text_shadow</shadowcolor>
            <visible>Control.HasFocus($PARAM[id]) + $PARAM[focused] + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)</visible>
            <scrollspeed>150</scrollspeed>
            <scroll>$PARAM[focused]</scroll>
          </control>
          <control type="label">
            <left>$PARAM[left_right_text]</left>
            <right>$PARAM[left_right_text]</right>
            <aligny>center</aligny>
            <font>$PARAM[unfocused_font]</font>
            <label>$VAR[MenuCaseVar]</label>
            <textcolor>$PARAM[focused_text]</textcolor>
            <align>$PARAM[align]</align>
            <shadowcolor>text_shadow</shadowcolor>
            <visible>$PARAM[focused] + $PARAM[active] + ![Control.HasFocus($PARAM[id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)]</visible>
          </control>
          <control type="label">
            <left>$PARAM[left_right_text]</left>
            <right>$PARAM[left_right_text]</right>
            <aligny>center</aligny>
            <font>$PARAM[unfocused_font]</font>
            <align>$PARAM[align]</align>
            <textcolor>unfocused_text</textcolor>
            <label>$VAR[MenuCaseVar]</label>
            <shadowcolor>text_shadow</shadowcolor>
            <visible>![[Control.HasFocus($PARAM[id]) + $PARAM[focused] + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)] | [$PARAM[focused] + $PARAM[active]]]</visible>
          </control>
        </control>
        <control type="group">
          <visible>!String.IsEmpty(ListItem.Property(icon)) | String.IsEqual(ListItem.Property(id),weather)</visible>
          <control type="label">
            <left>94</left>
            <right>27</right>
            <aligny>center</aligny>
            <font>$PARAM[unfocused_font]</font>
            <textcolor>unfocused_text</textcolor>
            <label>$VAR[MenuCaseVar]</label>
            <align>$PARAM[align]</align>
            <shadowcolor>text_shadow</shadowcolor>
            <visible>![[Control.HasFocus($PARAM[id]) + $PARAM[focused] + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)] | [$PARAM[focused] + $PARAM[active]]]</visible>
          </control>
          <control type="label">
            <left>94</left>
            <right>27</right>
            <aligny>center</aligny>
            <font>$PARAM[focused_font]</font>
            <label>$VAR[MenuCaseVar]</label>
            <textcolor>$PARAM[focused_text]</textcolor>
            <align>$PARAM[align]</align>
            <shadowcolor>text_shadow</shadowcolor>
            <visible>Control.HasFocus($PARAM[id]) + $PARAM[focused] + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)</visible>
            <scrollspeed>150</scrollspeed>
            <scroll>$PARAM[focused]</scroll>
          </control>
          <control type="label">
            <left>94</left>
            <right>27</right>
            <aligny>center</aligny>
            <font>$PARAM[unfocused_font]</font>
            <label>$VAR[MenuCaseVar]</label>
            <textcolor>$PARAM[focused_text]</textcolor>
            <align>$PARAM[align]</align>
            <shadowcolor>text_shadow</shadowcolor>
            <visible>$PARAM[focused] + $PARAM[active] + ![Control.HasFocus($PARAM[id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)]</visible>
          </control>
          <control type="label">
            <left>94</left>
            <right>27</right>
            <aligny>center</aligny>
            <font>$PARAM[unfocused_font]</font>
            <align>$PARAM[align]</align>
            <textcolor>unfocused_text</textcolor>
            <label>$VAR[MenuCaseVar]</label>
            <shadowcolor>text_shadow</shadowcolor>
            <visible>![[Control.HasFocus($PARAM[id]) + $PARAM[focused] + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[id]).CurrentItem)] | [$PARAM[focused] + $PARAM[active]]]</visible>
          </control>
        </control>
      </control>
    </definition>
  </include>

  <include name="ListItem">
    <param name="focused">false</param>
    <param name="img_top">0</param>
    <param name="img_bottom">0</param>
    <param name="align">left</param>
    <param name="left_right_text">30</param>
    <!-- <param name="img_left">47</param> -->
    <param name="focused_font">font37_title</param>
    <param name="unfocused_font">font37</param>
    <param name="img_texture">masks/radius_23.png</param>
    <param name="focused_text">$VAR[FocusedTextColorVar]</param>
    <definition>
      <control type="group">
        <control type="image">
          <top>$PARAM[img_top]</top>
          <bottom>$PARAM[img_bottom]</bottom>
          <left>0</left>
          <right>0</right>
          <texture border="23" colordiffuse="$VAR[FocusColorTheme]">$PARAM[img_texture]</texture>
          <visible>Control.HasFocus($PARAM[id]) + $PARAM[focused]</visible>
          <include condition="$PARAM[focused]">Animation_FocusTextureFade</include>
        </control>
        <!-- Section icon -->
        <control type="image">
          <left>25</left>
          <top>19</top>
          <width>47</width>
          <height>47</height>
          <texture diffuse="masks/mainmenu-img.png" colordiffuse="unfocused_text">$INFO[ListItem.Property(icon)]</texture>
          <aspectratio>keep</aspectratio>
          <visible>!String.IsEmpty(ListItem.Property(icon)) + [!Control.HasFocus($PARAM[id]) | !$PARAM[focused]]</visible>
        </control>
        <control type="image">
          <left>25</left>
          <top>19</top>
          <width>47</width>
          <height>47</height>
          <texture diffuse="masks/mainmenu-img.png" colordiffuse="$VAR[FocusedTextColorVar]">$INFO[ListItem.Property(icon)]</texture>
          <aspectratio>keep</aspectratio>
          <visible>!String.IsEmpty(ListItem.Property(icon)) + Control.HasFocus($PARAM[id]) + $PARAM[focused]</visible>
        </control>
        <control type="group">
          <visible>String.IsEmpty(ListItem.Property(icon))</visible>
          <control type="label">
            <left>$PARAM[left_right_text]</left>
            <right>$PARAM[left_right_text]</right>
            <aligny>center</aligny>
            <font>$PARAM[unfocused_font]</font>
            <textcolor>unfocused_text</textcolor>
            <label>$VAR[MenuCaseVar]</label>
            <align>$PARAM[align]</align>
            <shadowcolor>text_shadow</shadowcolor>
            <visible>!Control.HasFocus($PARAM[id]) | !$PARAM[focused]</visible>
          </control>
          <control type="label">
            <left>$PARAM[left_right_text]</left>
            <right>$PARAM[left_right_text]</right>
            <aligny>center</aligny>
