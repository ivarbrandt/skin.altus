<?xml version="1.0" encoding="UTF-8"?>
<includes>

  <include name="DefaultSimpleListLayout">
		<param name="align">left</param>
		<param name="height">122</param>
		<param name="pill_height">93</param>
		<param name="font">font32_bold</param>
		<definition>
			<itemlayout width="$PARAM[width]" height="$PARAM[height]">
				<control type="image">
					<height>$PARAM[pill_height]</height>
					<texture border="46" colordiffuse="4D000000">masks/radius_46.png</texture>
				</control>
				<control type="group">
					<height>$PARAM[pill_height]</height>
					<visible>ListItem.Property(PVR.IsRecordingTimer) | ListItem.Property(PVR.IsRemindingTimer)</visible>
					<control type="image">
						<left>30</left>
						<width>40</width>
						<aspectratio align="left">keep</aspectratio>
						<aligny>center</aligny>
						<texture>icons/pvr/timers/recording.png</texture>
						<visible>ListItem.Property(PVR.IsRecordingTimer)</visible>
					</control>
					<control type="image">
						<left>30</left>
						<width>40</width>
						<aspectratio align="left">keep</aspectratio>
						<aligny>center</aligny>
						<texture>icons/pvr/timers/bell.png</texture>
						<visible>ListItem.Property(PVR.IsRemindingTimer)</visible>
					</control>
					<control type="label">
						<left>90</left>
						<right>40</right>
						<align>$PARAM[align]</align>
						<font>$PARAM[font]</font>
						<aligny>center</aligny>
						<textcolor>unfocused_text</textcolor>
						<selectedcolor>unfocused_text</selectedcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</control>
				<control type="group">
					<height>$PARAM[pill_height]</height>
					<visible>!ListItem.Property(PVR.IsRecordingTimer) + !ListItem.Property(PVR.IsRemindingTimer)</visible>
					<control type="label">
						<left>40</left>
						<right>115</right>
						<align>$PARAM[align]</align>
						<font>$PARAM[font]</font>
						<aligny>center</aligny>
						<textcolor>unfocused_text</textcolor>
						<selectedcolor>unfocused_text</selectedcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="image">
						<right>40</right>
						<top>29</top>
						<width>35</width>
						<height>35</height>
						<texture colordiffuse="unfocused_text">masks/radio-button-on.png</texture>
						<visible>ListItem.IsSelected</visible>
					</control>
					<control type="image">
						<right>40</right>
						<top>29</top>
						<width>35</width>
						<height>35</height>
						<texture colordiffuse="unfocused_text">masks/radio-button-off.png</texture>
						<visible>!ListItem.IsSelected</visible>
					</control>
				</control>
			</itemlayout>
			<focusedlayout width="$PARAM[width]" height="$PARAM[height]" infoupdate="30">
				<control type="image">
					<height>$PARAM[pill_height]</height>
					<texture border="46" colordiffuse="4D000000">masks/radius_46.png</texture>
					<visible>![Control.HasFocus($PARAM[list_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)]</visible>
				</control>
				<control type="image">
					<height>$PARAM[pill_height]</height>
					<texture border="46" colordiffuse="A6000000">masks/radius_46.png</texture>
					<visible>Control.HasFocus($PARAM[list_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)</visible>
				</control>
				<control type="group">
					<height>$PARAM[pill_height]</height>
					<include content="FocusBorder">
						<param name="list_id" value="$PARAM[list_id]"/>
						<param name="focused" value="true"/>
						<param name="radius" value="46"/>
						<param name="border" value="46"/>
					</include>
				</control>
				<control type="group">
					<height>$PARAM[pill_height]</height>
					<visible>ListItem.Property(PVR.IsRecordingTimer) | ListItem.Property(PVR.IsRemindingTimer)</visible>
					<control type="image">
						<left>30</left>
						<width>40</width>
						<aspectratio align="left">keep</aspectratio>
						<aligny>center</aligny>
						<texture>icons/pvr/timers/recording.png</texture>
						<visible>ListItem.Property(PVR.IsRecordingTimer)</visible>
					</control>
					<control type="image">
						<left>30</left>
						<width>40</width>
						<aspectratio align="left">keep</aspectratio>
						<aligny>center</aligny>
						<texture>icons/pvr/timers/bell.png</texture>
						<visible>ListItem.Property(PVR.IsRemindingTimer)</visible>
					</control>
					<control type="label">
						<left>90</left>
						<right>40</right>
						<align>$PARAM[align]</align>
						<font>$PARAM[font]</font>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
						<textcolor>unfocused_text</textcolor>
						<selectedcolor>unfocused_text</selectedcolor>
						<visible>![Control.HasFocus($PARAM[list_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)]</visible>
					</control>
					<control type="label">
						<left>90</left>
						<right>40</right>
						<align>$PARAM[align]</align>
						<font>$PARAM[font]</font>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
						<textcolor>$VAR[FocusColorTheme]</textcolor>
						<selectedcolor>$VAR[FocusColorTheme]</selectedcolor>
						<scroll>true</scroll>
						<visible>Control.HasFocus($PARAM[list_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)</visible>
					</control>
				</control>
				<control type="group">
					<height>$PARAM[pill_height]</height>
					<visible>!ListItem.Property(PVR.IsRecordingTimer) + !ListItem.Property(PVR.IsRemindingTimer)</visible>
					<control type="label">
						<left>40</left>
						<right>115</right>
						<align>$PARAM[align]</align>
						<font>$PARAM[font]</font>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
						<textcolor>unfocused_text</textcolor>
						<selectedcolor>unfocused_text</selectedcolor>
						<visible>![Control.HasFocus($PARAM[list_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)]</visible>
					</control>
					<control type="label">
						<left>40</left>
						<right>115</right>
						<align>$PARAM[align]</align>
						<font>$PARAM[font]</font>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
						<textcolor>$VAR[FocusColorTheme]</textcolor>
						<selectedcolor>$VAR[FocusColorTheme]</selectedcolor>
						<scroll>true</scroll>
						<visible>Control.HasFocus($PARAM[list_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)</visible>
					</control>
					<control type="image">
						<right>40</right>
						<top>29</top>
						<width>35</width>
						<height>35</height>
						<texture colordiffuse="unfocused_text">masks/radio-button-on.png</texture>
						<visible>ListItem.IsSelected + ![Control.HasFocus($PARAM[list_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)]</visible>
					</control>
					<control type="image">
						<right>40</right>
						<top>29</top>
						<width>35</width>
						<height>35</height>
						<texture colordiffuse="unfocused_text">masks/radio-button-off.png</texture>
						<visible>!ListItem.IsSelected + ![Control.HasFocus($PARAM[list_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)]</visible>
					</control>
					<control type="image">
						<right>40</right>
						<top>29</top>
						<width>35</width>
						<height>35</height>
						<texture colordiffuse="$VAR[FocusColorTheme]">masks/radio-button-on.png</texture>
						<visible>ListItem.IsSelected + Control.HasFocus($PARAM[list_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)</visible>
					</control>
					<control type="image">
						<right>40</right>
						<top>29</top>
						<width>35</width>
						<height>35</height>
						<texture colordiffuse="$VAR[FocusColorTheme]">masks/radio-button-off.png</texture>
						<visible>!ListItem.IsSelected + Control.HasFocus($PARAM[list_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)</visible>
					</control>
				</control>
			</focusedlayout>
		</definition>
	</include>

</includes>
