<?xml version="1.0" encoding="UTF-8"?>
<includes>

  <include name="WidgetListPVRLayout">
		<param name="icon">$INFO[ListItem.Icon]</param>
    <param name="label">$INFO[ListItem.ChannelName]</param>
		<param name="label2">$INFO[ListItem.Title]</param>
		<param name="focused">false</param>
		<definition>
			<control type="group">
        <top>26</top>
        <left>20</left>
				<width>675</width>
				<height>227</height>
				<control type="image">
					<texture border="23" colordiffuse="4D000000">masks/radius_23.png</texture>
				</control>
				<include content="FocusBorder">
					<param name="list_id" value="$PARAM[list_id]"/>
					<param name="focused" value="$PARAM[focused]"/>
					<param name="radius" value="23"/>
					<param name="border" value="23"/>
				</include>
				<control type="image">
					<left>30</left>
					<top>28</top>
					<animation effect="slide" end="0,16" time="0" condition="Integer.IsEqual(ListItem.Progress,0)">Conditional</animation>
					<width>170</width>
					<height>140</height>
					<texture fallback="DefaultTVShows.png" background="true">$PARAM[icon]</texture>
					<aspectratio align="center" aligny="center">keep</aspectratio>
				</control>
				<control type="image">
					<right>20</right>
					<top>20</top>
					<width>35</width>
					<height>35</height>
					<texture colordiffuse="$VAR[FocusColorTheme]">$VAR[WallWatchedIconVar]</texture>
				</control>
				<control type="group">
					<left>230</left>
					<right>70</right>
					<animation effect="slide" end="0,16" time="0" condition="Integer.IsEqual(ListItem.Progress,0)">Conditional</animation>
					<animation effect="slide" end="0,18" time="0" condition="String.IsEmpty(ListItem.NextTitle)">Conditional</animation>
					<control type="label">
						<top>21</top>
						<height>36</height>
						<aligny>center</aligny>
						<label>$PARAM[label]</label>
						<scroll>$PARAM[focused] + Control.HasFocus($PARAM[list_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)</scroll>
						<scrollspeed>125</scrollspeed>
						<font>font27</font>
						<textcolor>grey</textcolor>
						<selectedcolor>grey</selectedcolor>
					</control>
					<control type="label">
						<top>57</top>
						<height>44</height>
						<aligny>center</aligny>
						<label>$PARAM[label2]</label>
						<scroll>$PARAM[focused] + Control.HasFocus($PARAM[list_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)</scroll>
						<scrollspeed>125</scrollspeed>
						<font>font32_title</font>
						<textcolor>unfocused_text</textcolor>
						<selectedcolor>unfocused_text</selectedcolor>
					</control>
					<control type="label">
						<top>101</top>
						<height>36</height>
						<aligny>center</aligny>
						<label>$INFO[ListItem.StartTime]$INFO[ListItem.EndTime, - ]</label>
						<font>font27</font>
						<textcolor>unfocused_text</textcolor>
						<selectedcolor>unfocused_text</selectedcolor>
					</control>
					<control type="label">
						<top>137</top>
						<height>36</height>
						<aligny>center</aligny>
						<label>$VAR[WidgetUnfocusedPVRNextProgrammeLabel]</label>
						<scroll>$PARAM[focused] + Control.HasFocus($PARAM[list_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)</scroll>
						<scrollspeed>125</scrollspeed>
						<font>font27</font>
						<textcolor>unfocused_text</textcolor>
						<selectedcolor>unfocused_text</selectedcolor>
					</control>
				</control>
				<control type="group">
					<left>30</left>
					<right>30</right>
					<top>196</top>
					<height>4</height>
					<visible>!Integer.IsEqual(ListItem.Progress,0)</visible>
					<control type="progress">
						<height>4</height>
						<info>ListItem.PercentPlayed</info>
					</control>
					<control type="progress">
						<height>4</height>
						<info>ListItem.Progress</info>
					</control>
				</control>
			</control>
		</definition>
	</include>

</includes>
