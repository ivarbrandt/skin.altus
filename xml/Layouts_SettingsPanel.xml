<?xml version="1.0" encoding="UTF-8"?>
<includes>

  <include name="SettingsPanel">
		<itemlayout height="190" width="533">
			<control type="image">
				<width>493</width>
				<height>150</height>
				<texture border="46" colordiffuse="4D000000">masks/radius_46.png</texture>
			</control>
			<control type="image">
				<centertop>40%</centertop>
				<centerleft>15%</centerleft>
				<width>80</width>
				<texture colordiffuse="unfocused_text">$INFO[ListItem.Icon]</texture>
				<aspectratio>keep</aspectratio>
			</control>
			<control type="textbox">
				<left>150</left>
				<width>50%</width>
				<centertop>40%</centertop>
				<label>$INFO[ListItem.Label]</label>
				<font>font40_settings</font>
				<textcolor>unfocused_text</textcolor>
				<aligny>center</aligny>
			</control>
		</itemlayout>
		<focusedlayout height="190" width="533" infoupdate="300">
			<control type="group">
				<depth>DepthContentPopout</depth>
				<control type="image">
					<width>493</width>
					<height>150</height>
					<texture border="46" colordiffuse="4D000000">masks/radius_46.png</texture>
					<visible>![Control.HasFocus(9000) + Integer.IsEqual(ListItem.CurrentItem,Container(9000).CurrentItem)]</visible>
				</control>
				<control type="image">
					<width>493</width>
					<height>150</height>
					<texture border="46" colordiffuse="A6000000">masks/radius_46.png</texture>
					<visible>Control.HasFocus(9000) + Integer.IsEqual(ListItem.CurrentItem,Container(9000).CurrentItem)</visible>
				</control>
				<include content="FocusBorder">
					<param name="list_id" value="9000"/>
					<param name="focused" value="true"/>
					<param name="radius" value="46"/>
					<param name="border" value="46"/>
					<param name="right" value="40"/>
					<param name="bottom" value="40"/>
				</include>
				<control type="image">
					<centertop>40%</centertop>
					<centerleft>15%</centerleft>
					<width>80</width>
					<texture colordiffuse="unfocused_text">$INFO[ListItem.Icon]</texture>
					<aspectratio>keep</aspectratio>
					<visible>![Control.HasFocus(9000) + Integer.IsEqual(ListItem.CurrentItem,Container(9000).CurrentItem)]</visible>
				</control>
				<control type="image">
					<centertop>40%</centertop>
					<centerleft>15%</centerleft>
					<width>80</width>
					<texture colordiffuse="$VAR[FocusColorTheme]">$INFO[ListItem.Icon]</texture>
					<aspectratio>keep</aspectratio>
					<visible>Control.HasFocus(9000) + Integer.IsEqual(ListItem.CurrentItem,Container(9000).CurrentItem)</visible>
				</control>
				<control type="textbox">
					<left>150</left>
					<width>50%</width>
					<centertop>40%</centertop>
					<label>$INFO[ListItem.Label]</label>
					<font>font40_settings</font>
					<textcolor>unfocused_text</textcolor>
					<aligny>center</aligny>
					<visible>![Control.HasFocus(9000) + Integer.IsEqual(ListItem.CurrentItem,Container(9000).CurrentItem)]</visible>
				</control>
				<control type="textbox">
					<left>150</left>
					<width>50%</width>
					<centertop>40%</centertop>
					<label>$INFO[ListItem.Label]</label>
					<font>font40_settings</font>
					<textcolor>$VAR[FocusColorTheme]</textcolor>
					<aligny>center</aligny>
					<visible>Control.HasFocus(9000) + Integer.IsEqual(ListItem.CurrentItem,Container(9000).CurrentItem)</visible>
				</control>
			</control>
		</focusedlayout>
	</include>

</includes>
