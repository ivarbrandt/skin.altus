<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
	<defaultcontrol always="true">3000</defaultcontrol>
	<depth>DepthDialog</depth>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>1890</width>
			<height>1045</height>

			<include content="DialogBackgroundCommons">
				<param name="header_label" value="Search Manager" />
				<param name="header_id" value="1" />
				<param name="width" value="1890" />
				<param name="height" value="1045" />
				<param name="header_top" value="15" />
				<param name="divider_top" value="90" />
				<param name="blur" value="true" />
				<param name="blur_mask" value="masks/dialogaddonsettings.png" />
			</include>

			<!-- ═══════════════════════════════════════ -->
			<!-- LEFT PANEL: Search Widgets (40-720)     -->
			<!-- ═══════════════════════════════════════ -->
			<control type="group">
				<left>20</left>
				<top>100</top>
				<width>780</width>
				<height>911</height>

				<!-- Header: label + reorder indicator -->
				<control type="grouplist">
					<left>20</left>
					<top>10</top>
					<width>740</width>
					<height>55</height>
					<orientation>horizontal</orientation>
					<itemgap>2</itemgap>
					<align>left</align>

					<control type="label">
						<width>auto</width>
						<height>55</height>
						<label>Search Widgets</label>
						<font>font36_title</font>
						<textcolor>$VAR[FocusColorTheme]</textcolor>
					</control>

					<!-- Reorder mode indicator icon -->
					<control type="group">
						<width>42</width>
						<height>55</height>
						<visible>!String.IsEmpty(Window.Property(reorder_widgets))</visible>
						<animation effect="fade" time="200">VisibleChange</animation>
						<control type="image">
							<top>5</top>
							<width>37</width>
							<height>55</height>
							<texture colordiffuse="$VAR[FocusColorTheme]">buttons/widget_manager/reorder.png</texture>
							<aspectratio aligny="center">keep</aspectratio>
						</control>
					</control>
				</control>

				<!-- Empty-state Add button -->
				<control type="button" id="3500">
					<left>20</left>
					<top>85</top>
					<right>20</right>
					<height>89</height>
					<label>Add Search Widget...</label>
					<font>font32_bold</font>
					<textoffsetx>38</textoffsetx>
					<aligny>center</aligny>
					<texturefocus border="33" colordiffuse="A6000000">masks/radius_33.png</texturefocus>
					<texturenofocus border="33" colordiffuse="4D000000">masks/radius_33.png</texturenofocus>
					<textcolor>unfocused_text</textcolor>
					<focusedcolor>$VAR[FocusColorTheme]</focusedcolor>
					<visible>!Integer.IsGreater(Container(3000).NumItems,0)</visible>
				</control>
				<control type="image">
					<left>20</left>
					<top>85</top>
					<right>20</right>
					<height>89</height>
					<texture border="33" colordiffuse="$VAR[FocusColorTheme]" infill="false">masks/bordertexture-33_alt.png</texture>
					<visible>Control.HasFocus(3500)</visible>
				</control>

				<!-- Search widgets list -->
				<control type="list" id="3000">
					<left>20</left>
					<top>85</top>
					<right>20</right>
					<height>822</height>
					<scrolltime tween="cubic" easing="out">300</scrolltime>
					<pagecontrol>3001</pagecontrol>
					<itemlayout width="740" height="137">
						<control type="image">
							<left>0</left>
							<top>0</top>
							<right>0</right>
							<height>108</height>
							<texture border="33" colordiffuse="4D000000">masks/radius_33.png</texture>
						</control>
						<control type="label">
							<left>38</left>
							<top>8</top>
							<right>10</right>
							<height>40</height>
							<font>font32_bold</font>
							<textcolor>unfocused_text</textcolor>
							<label>$INFO[ListItem.Label]</label>
							<aligny>top</aligny>
						</control>
						<control type="label">
							<left>38</left>
							<bottom>55</bottom>
							<right>10</right>
							<height>34</height>
							<font>font23_title</font>
							<textcolor>60FFFFFF</textcolor>
							<label>$INFO[ListItem.Label2]</label>
							<aligny>bottom</aligny>
						</control>
					</itemlayout>
					<focusedlayout width="740" height="137">
						<!-- Focus background -->
						<control type="image">
							<left>0</left>
							<top>0</top>
							<right>0</right>
							<height>108</height>
							<texture border="33" colordiffuse="4D000000">masks/radius_33.png</texture>
							<visible>!Control.HasFocus(3000) + !ControlGroup(5001).HasFocus</visible>
						</control>
						<control type="image">
							<left>0</left>
							<top>0</top>
							<right>0</right>
							<height>108</height>
							<texture border="33" colordiffuse="A6000000">masks/radius_33.png</texture>
							<visible>Control.HasFocus(3000) | ControlGroup(5001).HasFocus</visible>
						</control>
						<control type="image">
							<left>0</left>
							<top>0</top>
							<right>0</right>
							<height>108</height>
							<texture border="33" colordiffuse="$VAR[FocusColorTheme]" infill="false">masks/bordertexture-33_alt.png</texture>
							<visible>Control.HasFocus(3000)</visible>
						</control>
						<!-- Main label, unfocused -->
						<control type="label">
							<visible>!Control.HasFocus(3000)</visible>
							<left>38</left>
							<top>8</top>
							<right>10</right>
							<height>40</height>
							<font>font32_bold</font>
							<textcolor>$VAR[WM_WidgetLabelColor]</textcolor>
							<label>$INFO[ListItem.Label]</label>
							<aligny>top</aligny>
						</control>
						<!-- Main label, focused -->
						<control type="label">
							<visible>Control.HasFocus(3000)</visible>
							<left>38</left>
							<top>8</top>
							<right>180</right>
							<height>40</height>
							<font>font32_bold</font>
							<textcolor>$VAR[FocusColorTheme]</textcolor>
							<label>$INFO[ListItem.Label]</label>
							<aligny>top</aligny>
							<scroll>true</scroll>
							<scrollspeed>75</scrollspeed>
						</control>
						<!-- Sub label, unfocused -->
						<control type="label">
							<visible>!Control.HasFocus(3000)</visible>
							<left>38</left>
							<bottom>55</bottom>
							<right>10</right>
							<height>34</height>
							<font>font23_title</font>
							<textcolor>60FFFFFF</textcolor>
							<label>$INFO[ListItem.Label2]</label>
							<aligny>bottom</aligny>
						</control>
						<!-- Sub label, focused -->
						<control type="label">
							<visible>Control.HasFocus(3000)</visible>
							<left>38</left>
							<bottom>55</bottom>
							<right>180</right>
							<height>34</height>
							<font>font23_title</font>
							<textcolor>unfocused_text</textcolor>
							<label>$INFO[ListItem.Label2]</label>
							<aligny>bottom</aligny>
							<scroll>true</scroll>
							<scrollspeed>75</scrollspeed>
						</control>

						<!-- Inline icon buttons (right-aligned) -->
						<include content="WM_InlineBtn">
							<param name="btn_id" value="add" />
							<param name="btn_icon" value="buttons/widget_manager/add.png" />
							<param name="btn_left" value="556" />
							<param name="btn_top" value="23" />
							<param name="list_id" value="3000" />
							<param name="btn_prop" value="search_active_btn" />
						</include>
						<include content="WM_InlineBtn">
							<param name="btn_id" value="reorder" />
							<param name="btn_icon" value="buttons/widget_manager/reorder.png" />
							<param name="btn_left" value="603" />
							<param name="btn_top" value="23" />
							<param name="list_id" value="3000" />
							<param name="btn_prop" value="search_active_btn" />
						</include>
						<include content="WM_InlineBtn">
							<param name="btn_id" value="delete" />
							<param name="btn_icon" value="buttons/widget_manager/trash.png" />
							<param name="btn_left" value="650" />
							<param name="btn_top" value="23" />
							<param name="list_id" value="3000" />
							<param name="btn_prop" value="search_active_btn" />
						</include>
					</focusedlayout>
				</control>

				<!-- Divider -->
				<control type="image">
					<left>790</left>
					<top>85</top>
					<width>1</width>
					<height>793</height>
					<texture colordiffuse="$VAR[FocusColorTheme]">colors/greyer.png</texture>
				</control>

				<!-- Scrollbar -->
				<control type="scrollbar" id="3001">
					<left>789</left>
					<top>85</top>
					<width>3</width>
					<height>793</height>
					<orientation>vertical</orientation>
					<texturesliderbackground/>
					<texturesliderbar colordiffuse="$VAR[FocusColorTheme]">colors/white.png</texturesliderbar>
					<texturesliderbarfocus colordiffuse="$VAR[FocusColorTheme]">colors/white.png</texturesliderbarfocus>
					<showonepage>false</showonepage>
				</control>
			</control>

			<!-- ═══════════════════════════════════════ -->
			<!-- RIGHT PANEL: Details (740+)             -->
			<!-- ═══════════════════════════════════════ -->
			<control type="group">
				<left>821</left>
				<top>100</top>
				<right>40</right>
				<height>911</height>

				<!-- Header -->
				<control type="label">
					<left>20</left>
					<top>10</top>
					<height>55</height>
					<label>Details</label>
					<font>font36_title</font>
					<textcolor>$VAR[FocusColorTheme]</textcolor>
				</control>

				<!-- Empty state -->
				<control type="label" id="5000">
					<left>20</left>
					<top>85</top>
					<right>0</right>
					<height>43</height>
					<label>Add a search widget to get started</label>
					<font>font27_title</font>
					<textcolor>60FFFFFF</textcolor>
					<aligny>center</aligny>
					<visible>!Integer.IsGreater(Container(3000).NumItems,0)</visible>
				</control>

				<!-- Detail fields grouplist -->
				<control type="grouplist" id="5001">
					<left>20</left>
					<top>85</top>
					<right>0</right>
					<bottom>0</bottom>
					<orientation>vertical</orientation>
					<itemgap>0</itemgap>
					<onleft>3000</onleft>
					<scrolltime tween="cubic" easing="out">300</scrolltime>
					<visible>Integer.IsGreater(Container(3000).NumItems,0)</visible>

					<!-- Label -->
					<include content="WM_DetailRow">
						<param name="id" value="5100" />
						<param name="label" value="Label:" />
						<param name="value" value="$VAR[SM_DetailLabel]" />
						<param name="width" value="1009" />
						<param name="onleft" value="3000" />
						<param name="up" value="5106" />
						<param name="down" value="5101" />
					</include>

					<!-- Content Type -->
					<include content="WM_DetailRow">
						<param name="id" value="5101" />
						<param name="label" value="Content Type:" />
						<param name="value" value="$VAR[SM_DetailKind]" />
						<param name="width" value="1009" />
						<param name="onleft" value="3000" />
						<param name="up" value="5100" />
						<param name="down" value="5102" />
					</include>

					<!-- Path Template -->
					<include content="WM_DetailRow">
						<param name="id" value="5102" />
						<param name="label" value="Path:" />
						<param name="value" value="$VAR[SM_DetailUrl]" />
						<param name="width" value="1009" />
						<param name="onleft" value="3000" />
						<param name="up" value="5101" />
						<param name="down" value="5103" />
					</include>

					<!-- Display Type (for stacked widgets, this is the stacked child type) -->
					<include content="WM_DetailRow">
						<param name="id" value="5103" />
						<param name="label" value="Display Type:" />
						<param name="value" value="$VAR[SM_DetailDisplayType]" />
						<param name="width" value="1009" />
						<param name="onleft" value="3000" />
						<param name="up" value="5102" />
						<param name="down" value="5104" />
					</include>

					<!-- Target -->
					<include content="WM_DetailRow">
						<param name="id" value="5104" />
						<param name="label" value="Target:" />
						<param name="value" value="$VAR[SM_DetailTarget]" />
						<param name="width" value="1009" />
						<param name="onleft" value="3000" />
						<param name="up" value="5103" />
						<param name="down" value="5105" />
					</include>

					<!-- Stacked toggle -->
					<include content="WM_DetailRow">
						<param name="id" value="5105" />
						<param name="label" value="Stacked:" />
						<param name="value" value="$VAR[SM_DetailStacked]" />
						<param name="width" value="1009" />
						<param name="onleft" value="3000" />
						<param name="up" value="5104" />
						<param name="down" value="5106" />
					</include>

					<!-- Test This Path (P7 stub) -->
					<include content="WM_DetailRow">
						<param name="id" value="5106" />
						<param name="label" value="Test This Path" />
						<param name="width" value="1009" />
						<param name="onleft" value="3000" />
						<param name="up" value="5105" />
						<param name="down" value="5100" />
					</include>
				</control>
			</control>
		</control>
	</controls>
</window>
