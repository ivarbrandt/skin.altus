<?xml version="1.0" encoding="utf-8"?>
<window>
	<defaultcontrol always="true">2</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="button">
			<description>background close area</description>
			<left>0</left>
			<top>0</top>
			<width>100%</width>
			<bottom>546</bottom>
			<texturefocus />
			<texturenofocus />
			<onclick>Action(close)</onclick>
		</control>
		<control type="image">
			<top>0</top>
			<left>0</left>
			<width>100%</width>
			<height>700</height>
			<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="300">WindowClose</animation>
			<texture flipy="true" colordiffuse="ed080808">osd/osdoverlay.png</texture>
		</control>
		<control type="group">
			<top>30</top>
			<bottom>0</bottom>
			<height>550</height>
			<control type="textbox">
				<left>0</left>
				<top>1</top>
				<width>1920</width>
				<height>410</height>
				<align>center</align>
				<aligny>center</aligny>
				<font>font45_title</font>
				<label>$LOCALIZE[31155]</label>
				<visible>Integer.IsEqual(Container(11).NumItems,0)</visible>
			</control>
			<control type="grouplist" id="9001">
				<orientation>horizontal</orientation>
				<left>0</left>
				<top>0</top>
				<width>100%</width>
				<align>center</align>
				<height>100</height>
				<onup>11</onup>
				<ondown>11</ondown>
				<itemgap>dialogbuttons_itemgap</itemgap>
				<include content="DefaultDialogButton">
					<param name="id" value="2" />
					<param name="label" value="$LOCALIZE[294]" />
					<param name="width" value="300" />
				</include>
				<include content="DefaultDialogButton">
					<param name="id" value="3" />
					<param name="label" value="$LOCALIZE[296]" />
					<param name="width" value="300" />
				</include>
				<include content="DefaultDialogButton">
					<param name="id" value="4" />
					<param name="label" value="$LOCALIZE[20406]" />
					<param name="width" value="300" />
					<param name="visible" value="Control.IsEnabled(4)" />
				</include>
			</control>
			<control type="panel" id="11">
				<left>0</left>
				<top>101</top>
				<width>100%</width>
				<height>350</height>
				<onup>9001</onup>
				<ondown>9001</ondown>
				<preloaditems>2</preloaditems>
				<scrolltime tween="sine">200</scrolltime>
				<orientation>horizontal</orientation>
				<itemlayout width="360" height="340">
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>331</width>
						<height>250</height>
						<texture diffuse="osd/bookmarks.png" fallback="DefaultVideo.png">$INFO[ListItem.Art(thumb)]</texture>
					</control>
					<control type="label">
						<left>0</left>
						<top>260</top>
						<width>331</width>
						<height>70</height>
						<label>$INFO[ListItem.Label][CR]$INFO[ListItem.Label2]</label>
						<font>font27_title</font>
						<textcolor>unfocused_text</textcolor>
						<align>center</align>
					</control>
				</itemlayout>
				<focusedlayout width="360" height="340">
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>331</width>
						<height>250</height>
						<texture diffuse="osd/bookmarks.png" fallback="DefaultVideo.png">$INFO[ListItem.Art(thumb)]</texture>
					</control>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>331</width>
						<height>250</height>
						<texture border="26" colordiffuse="$VAR[FocusColorTheme]" infill="false">masks/bordertexture-26.png</texture>
						<visible>Control.HasFocus(11)</visible>
					</control>
					<control type="label">
						<left>0</left>
						<top>260</top>
						<width>331</width>
						<height>70</height>
						<label>$INFO[ListItem.Label][CR]$INFO[ListItem.Label2]</label>
						<font>font27_title</font>
						<textcolor>unfocused_text</textcolor>
						<align>center</align>
						<visible>!Control.HasFocus(11)</visible>
					</control>
					<control type="label">
						<left>0</left>
						<top>260</top>
						<width>331</width>
						<height>70</height>
						<label>$INFO[ListItem.Label][CR]$INFO[ListItem.Label2]</label>
						<font>font27_title</font>
						<textcolor>$VAR[FocusColorTheme]</textcolor>
						<align>center</align>
						<visible>Control.HasFocus(11)</visible>
					</control>
				</focusedlayout>
			</control>
		</control>
	</controls>
</window>
