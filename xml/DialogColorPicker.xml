<?xml version="1.0" encoding="utf-8"?>
<window>
	<defaultcontrol always="true">6</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<depth>DepthOSD</depth>
	<controls>
		<control type="group">
			<centertop>50%</centertop>
			<height>1038</height>
			<centerleft>50%</centerleft>
			<width>1575</width>
			<include content="DialogBackgroundCommons">
				<param name="header_label" value="$LOCALIZE[737]" />
				<param name="header_id" value="1" />
				<param name="width" value="1575" />
				<param name="height" value="1038" />
				<param name="header_top" value="15" />
				<param name="divider_top" value="90" />
				<param name="blur" value="true" />
				<param name="blur_mask" value="masks/dialogcolorpicker.png" />
			</include>
			<control type="panel" id="6">
				<description>Colour swatches</description>
				<left>40</left>
				<top>130</top>
				<width>1224</width>
				<height>816</height>
				<onup>6</onup>
				<ondown>6</ondown>
				<onleft>9001</onleft>
				<onright>61</onright>
				<orientation>vertical</orientation>
				<pagecontrol>61</pagecontrol>
				<scrolltime tween="cubic" easing="out">500</scrolltime>
				<viewtype label="100">icon</viewtype>
				<itemlayout height="136" width="136">
					<control type="image">
						<width>107</width>
						<height>107</height>
						<texture border="23" colordiffuse="4D000000">masks/radius_23.png</texture>
					</control>
					<control type="image">
						<width>107</width>
						<height>107</height>
						<texture border="23">masks/radius_23-unfo.png</texture>
						<colordiffuse>$INFO[ListItem.Label2]</colordiffuse>
					</control>
				</itemlayout>
				<focusedlayout height="136" width="136">
					<control type="group">
						<animation effect="zoom" start="100" end="120" center="53,53" time="200" tween="sine" easing="inout">Focus</animation>
						<control type="image">
							<width>107</width>
							<height>107</height>
							<texture border="23" colordiffuse="4D000000">masks/radius_23.png</texture>
						</control>
						<control type="image">
							<width>107</width>
							<height>107</height>
							<texture border="23">masks/radius_23-unfo.png</texture>
							<colordiffuse>$INFO[ListItem.Label2]</colordiffuse>
						</control>
					</control>
				</focusedlayout>
			</control>
			<control type="image">
				<description>Divider before the dialog buttons</description>
				<left>1275</left>
				<top>130</top>
				<width>1</width>
				<height>787</height>
				<texture colordiffuse="$VAR[FocusColorTheme]">colors/greyer.png</texture>
			</control>
			<control type="scrollbar" id="61">
				<left>1274</left>
				<top>130</top>
				<width>3</width>
				<height>787</height>
				<onleft condition="Control.IsVisible(6)">6</onleft>
				<onright>9001</onright>
				<onup>61</onup>
				<ondown>61</ondown>
				<orientation>vertical</orientation>
			</control>
			<control type="label">
				<description>Selected colour name and value</description>
				<left>40</left>
				<top>946</top>
				<width>1224</width>
				<height>52</height>
				<align>left</align>
				<aligny>center</aligny>
				<font>font32_bold</font>
				<textcolor>unfocused_text</textcolor>
				<label>[COLOR $VAR[FocusColorTheme]]$LOCALIZE[737]: [/COLOR]$INFO[Container(6).ListItem.Label,, - ]$INFO[Container(6).ListItem.Label2,#,]</label>
			</control>
			<control type="label">
				<description>Item count</description>
				<left>1316</left>
				<top>876</top>
				<width>219</width>
				<height>52</height>
				<align>left</align>
				<aligny>bottom</aligny>
				<font>font27_title</font>
				<textcolor>$VAR[FocusColorTheme]</textcolor>
				<label>$INFO[Container(6).NumItems] [COLOR unfocused_text]$LOCALIZE[31036][/COLOR]</label>
			</control>
			<control type="grouplist" id="9001">
				<description>Dialog buttons</description>
				<left>1316</left>
				<top>130</top>
				<width>219</width>
				<height>80</height>
				<onleft>61</onleft>
				<onright>6</onright>
				<onup>9001</onup>
				<ondown>9001</ondown>
				<itemgap>dialogbuttons_itemgap</itemgap>
				<orientation>vertical</orientation>
				<include content="DefaultDialogButton">
					<param name="id" value="7" />
					<param name="width" value="219" />
					<param name="label" value="$LOCALIZE[222]" />
				</include>
			</control>
		</control>
	</controls>
</window>
