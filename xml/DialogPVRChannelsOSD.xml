<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">11</defaultcontrol>
	<controls>
		<control type="group">
			<animation effect="fade" start="100" end="0" time="200" tween="sine" condition="$EXP[infodialog_active]">Conditional</animation>
			<control type="group">
				<depth>DepthOSD</depth>
				<include content="OpenClose_Slide_Left">
					<param name="distance" value="1600" />
				</include>
				<control type="image">
					<left>-2000</left>
					<top>-2000</top>
					<width>6000</width>
					<height>6000</height>
					<animation effect="slide" end="-20000,-20000" time="0" condition="String.IsEqual(Window(Home).Property(altus.pvr.hiding_ctx),true)">Conditional</animation>
					<animation effect="fade" time="375">VisibleChange</animation>
					<animation effect="fade" start="0" end="100" time="375">WindowOpen</animation>
					<animation effect="fade" start="100" end="0" time="375">WindowClose</animation>
					<texture colordiffuse="A6FFFFFF">colors/black.png</texture>
				</control>
				<control type="button">
					<left>-2000</left>
					<top>-2000</top>
					<width>6000</width>
					<height>6000</height>
					<texturefocus />
					<texturenofocus />
					<onclick>Action(close)</onclick>
				</control>
				<control type="image">
					<left>-2</left>
					<top>0</top>
					<right>0</right>
					<bottom>0</bottom>
					<texture border="46" colordiffuse="$VAR[FocusColorTheme]">lists/contentpanel-fade-white.png</texture>
				</control>
				<control type="fixedlist" id="11">
					<left>40</left>
					<top>105</top>
					<width>812</width>
					<height>935</height>
					<onleft condition="Control.IsVisible(60)">60</onleft>
					<onleft condition="!Control.IsVisible(60)">PreviousChannelGroup</onleft>
					<onright>NextChannelGroup</onright>
					<onup>11</onup>
					<ondown>11</ondown>
					<movement>2</movement>
					<focusposition>2</focusposition>
					<pagecontrol>60</pagecontrol>
					<scrolltime tween="cubic" easing="out">500</scrolltime>
					<include content="PVRListItemLayouts">
						<param name="list_id" value="11" />
						<param name="label1" value="$INFO[ListItem.Label]" />
						<param name="has_status_icon" value="true" />
						<param name="info_update" value="5000" />
					</include>
				</control>
				<control type="scrollbar" id="60">
					<left>0</left>
					<!-- <left>941</left> -->
					<top>105</top>
					<width>8</width>
					<height>906</height>
					<onleft>NextChannelGroup</onleft>
					<onright>11</onright>
					<texturesliderbackground />
					<!-- <animation effect="zoom" start="80,100" end="70,100" center="982,0" time="300" tween="sine" easing="inout" condition="!Control.HasFocus(60)">conditional</animation> -->
					<animation effect="fade" time="300" start="0" end="100" tween="cubic" easing="inout">VisibleChange</animation>
					<visible>Control.HasFocus(60) | Container.Scrolling</visible>
				</control>
			</control>
			<control type="group">
				<depth>DepthOSD</depth>
				<include>Animation_TopSlide</include>
				<top>15</top>
				<control type="label" id="2">
					<description>header label</description>
					<textoffsetx>40</textoffsetx>
					<width>970</width>
					<height>70</height>
					<font>topbar_chrome</font>
					<aligny>center</aligny>
					<label>$VAR[BreadcrumbsPVRChannelsOSDVar]</label>
					<textcolor>$VAR[PlayerProgressColor]</textcolor>
				</control>
			</control>
		</control>
		<include>PVRChannelNumberInput</include>
	</controls>
</window>
