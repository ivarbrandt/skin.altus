			<control type="scrollbar" id="5600">
				<left>-8</left>
				<top>578</top>
				<bottom>0</bottom>
				<width>8</width>
				<texturesliderbackground />
				<texturesliderbar colordiffuse="$VAR[FocusColorTheme]">colors/white.png</texturesliderbar>
				<texturesliderbarfocus colordiffuse="$VAR[FocusColorTheme]">colors/white.png</texturesliderbarfocus>
				<orientation>vertical</orientation>
				<animation effect="slide" start="4,0" end="0,0" time="300" tween="sine" easing="inout" condition="!Container(56).Scrolling">Conditional</animation>
			</control>
			<include content="TopBottomBars">
				<param name="top_visible" value="false"/>
				<param name="bottom_visible" value="true"/>
				</include>
			</control>
