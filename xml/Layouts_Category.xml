<?xml version="1.0" encoding="UTF-8"?>
<includes>

  <include name="WidgetListCategoryLayout">
		<!-- <param name="item_limit">30</param> -->
		<param name="icon">$VAR[CategoryIcon]</param>
		<param name="fallback_icon">DefaultFolder.png</param>
		<param name="focused">false</param>
		<definition>
			<control type="group">
        <top>26</top>
        <left>20</left>
				<width>317</width>
				<height>155</height>
				<control type="image">
					<texture border="33" colordiffuse="4D000000">masks/radius_33.png</texture>
					<visible>!$PARAM[focused] | !Control.HasFocus($PARAM[list_id]) | !Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)</visible>
				</control>
				<control type="image">
					<texture border="33" colordiffuse="A6000000">masks/radius_33.png</texture>
					<visible>$PARAM[focused] + Control.HasFocus($PARAM[list_id]) + Integer.IsEqual(ListItem.CurrentItem,Container($PARAM[list_id]).CurrentItem)</visible>
				</control>
				<control type="group">
					<centertop>37%</centertop>
					<centerleft>50%</centerleft>
					<width>90</width>
					<height>90</height>
					<visible>!$EXP[isContent]</visible>
					<control type="image">
						<texture colordiffuse="unfocused_text" fallback="$PARAM[fallback_icon]" background="true">$PARAM[icon]</texture>
						<aspectratio aligny="center" align="center">keep</aspectratio>
					</control>
				</control>
				<control type="image">
					<centertop>50%</centertop>
					<centerleft>50%</centerleft>
					<width>258</width>
					<height>100</height>
					<texture colordiffuse="artwork_dim" background="true">$PARAM[icon]</texture>
					<aspectratio>keep</aspectratio>
					<visible>$EXP[isContent]</visible>
				</control>
				<control type="label">
					<centerleft>50%</centerleft>
					<width>280</width>
					<align>center</align>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
					<textcolor>unfocused_text</textcolor>
					<font>font25_title</font>
					<scroll>$PARAM[focused] + Control.HasFocus($PARAM[list_id])</scroll>
					<scrollspeed>50</scrollspeed>
					<visible>$EXP[isContent] + String.IsEmpty(ListItem.Art(clearlogo)) + String.IsEmpty(ListItem.Art(tvshow.clearlogo))</visible>
				</control>
				<include content="FocusBorder">
					<param name="list_id" value="$PARAM[list_id]"/>
					<param name="focused" value="$PARAM[focused]"/>
					<param name="radius" value="33"/>
					<param name="border" value="33"/>
				</include>
				<control type="label">
					<centerleft>50%</centerleft>
					<!-- 145 -->
					<top>82</top>
					<width>280</width>
					<height>65</height>
					<align>center</align>
					<aligny>center</aligny>
					<label>$VAR[AddonsTitleVar]</label>
					<textcolor>unfocused_text</textcolor>
					<font>font25_title</font>
					<scroll>$PARAM[focused] + Control.HasFocus($PARAM[list_id])</scroll>
					<scrollspeed>50</scrollspeed>
					<visible>!$EXP[isContent]</visible>
				</control>
			</control>
		</definition>
	</include>

  <include name="WidgetListCategoryStackedLayout">
		<!-- <param name="item_limit">30</param> -->
		<param name="icon">$INFO[ListItem.Icon]</param>
		<param name="focused">false</param>
		<definition>
			<control type="group">
        <top>26</top>
        <left>20</left>
				<!-- 139 -->
				<width>249</width>
				<height>87</height>
				<control type="image">
					<texture border="20" colordiffuse="4D000000">masks/radius_20.png</texture>
				</control>
				<control type="image">
					<texture border="20" colordiffuse="$VAR[FocusColorTheme]">masks/radius_20.png</texture>
					<visible>[$PARAM[focused] + Control.HasFocus($PARAM[list_id])] | [[!Control.HasFocus($PARAM[list_id]) + [String.IsEqual(Window(Home).Property(altus.search.child.$PARAM[list_id].label),ListItem.Label)]] + String.IsEqual(Window(Home).Property(altus_stacked_linked_list_id),$PARAM[list_id])]</visible>
				</control>
				<control type="textbox">
					<centertop>50%</centertop>
					<left>20</left>
					<right>20</right>
					<height>87</height>
					<align>center</align>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
					<textcolor>$VAR[FocusedTextColorVar]</textcolor>
					<font>font23_stacked_widgets_fo</font>
					<autoscroll delay="2000" time="3000" repeat="2000">$PARAM[focused]</autoscroll>
					<visible>[$PARAM[focused] + Control.HasFocus($PARAM[list_id])] | [[!Control.HasFocus($PARAM[list_id]) + [String.IsEqual(Window(Home).Property(altus.search.child.$PARAM[list_id].label),ListItem.Label)]] + String.IsEqual(Window(Home).Property(altus_stacked_linked_list_id),$PARAM[list_id])]</visible>
				</control>
				<control type="textbox">
					<centertop>50%</centertop>
					<left>20</left>
					<right>20</right>
					<height>87</height>
					<align>center</align>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
					<textcolor>unfocused_text</textcolor>
					<font>font23_stacked_widgets_fo</font>
					<visible>![[$PARAM[focused] + Control.HasFocus($PARAM[list_id])] | [[!Control.HasFocus($PARAM[list_id]) + [String.IsEqual(Window(Home).Property(altus.search.child.$PARAM[list_id].label),ListItem.Label)]] + String.IsEqual(Window(Home).Property(altus_stacked_linked_list_id),$PARAM[list_id])]]</visible>
				</control>
			</control>
		</definition>
	</include>

</includes>