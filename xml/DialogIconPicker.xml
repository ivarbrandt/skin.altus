<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
	<defaultcontrol always="true">3001</defaultcontrol>
	<depth>DepthOSD</depth>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<!-- Backdrop darken + close on click -->
		<control type="image">
			<left>-2000</left>
			<top>-2000</top>
			<width>6000</width>
			<height>6000</height>
			<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
			<texture colordiffuse="A6FFFFFF">colors/black.png</texture>
		</control>
		<control type="button">
			<left>-2000</left>
			<top>-2000</top>
			<width>6000</width>
			<height>6000</height>
			<texturefocus />
			<texturenofocus />
			<onclick>Action(close)</onclick>
		</control>

		<!-- Main dialog container -->
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>1450</width>
			<height>885</height>

			<include content="DialogBackgroundCommons">
				<param name="header_label" value="Choose icon" />
				<param name="header_id" value="1" />
				<param name="width" value="1450" />
				<param name="height" value="885" />
				<param name="header_top" value="15" />
				<param name="divider_top" value="90" />
				<param name="blur_mask" value="masks/dialogaddonsettings.png" />
			</include>

			<!-- Folder list (left side) -->
			<control type="list" id="3001">
				<left>40</left>
				<top>130</top>
				<width>320</width>
				<height>684</height>
				<onup>3001</onup>
				<ondown>3001</ondown>
				<onleft>3001</onleft>
				<onright>3000</onright>
				<pagecontrol>33</pagecontrol>
				<onfocus>RunScript(script.altus.helper,mode=icon_folder_debounce)</onfocus>
				<scrolltime tween="cubic" easing="out">300</scrolltime>
				<itemlayout width="320" height="114">
					<control type="image">
						<left>0</left>
						<top>0</top>
						<right>0</right>
						<height>85</height>
						<texture border="33" colordiffuse="4D000000">masks/radius_33.png</texture>
					</control>
					<control type="label">
						<left>38</left>
						<top>0</top>
						<right>20</right>
						<height>85</height>
						<font>font32_bold</font>
						<textcolor>unfocused_text</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<aligny>center</aligny>
					</control>
				</itemlayout>
				<focusedlayout width="320" height="114">
					<control type="image">
						<left>0</left>
						<top>0</top>
						<right>0</right>
						<height>85</height>
						<texture border="33" colordiffuse="A6000000">masks/radius_33.png</texture>
					</control>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<right>0</right>
						<height>85</height>
						<texture border="33" colordiffuse="$VAR[FocusColorTheme]" infill="false">masks/bordertexture-33_alt.png</texture>
						<visible>Control.HasFocus(3001)</visible>
					</control>
					<control type="label">
						<left>38</left>
						<top>0</top>
						<right>20</right>
						<height>85</height>
						<font>font32_bold</font>
						<textcolor>$VAR[FocusColorTheme]</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<aligny>center</aligny>
					</control>
				</focusedlayout>
			</control>

			<!-- Separator -->
			<control type="image">
				<height>655</height>
				<left>390</left>
				<top>130</top>
				<width>1</width>
				<texture colordiffuse="$VAR[FocusColorTheme]">colors/greyer.png</texture>
			</control>

			<control type="scrollbar" id="33">
				<height>655</height>
				<left>389</left>
				<top>130</top>
				<width>3</width>
				<orientation>vertical</orientation>
				<texturesliderbackground/>
				<texturesliderbar colordiffuse="$VAR[FocusColorTheme]">colors/white.png</texturesliderbar>
				<texturesliderbarfocus colordiffuse="$VAR[FocusColorTheme]">colors/white.png</texturesliderbarfocus>
				<showonepage>false</showonepage>
			</control>

			<!-- Icon grid panel -->
			<control type="panel" id="3000">
				<left>420</left>
				<top>130</top>
				<width>990</width>
				<height>660</height>
				<onup>3000</onup>
				<ondown>3000</ondown>
				<onleft>3001</onleft>
				<onright>3000</onright>
				<orientation>vertical</orientation>
				<itemlayout height="110" width="110">
					<control type="group">
						<left>5</left>
						<top>5</top>
						<width>100</width>
						<height>100</height>
						<control type="image">
							<left>0</left>
							<top>0</top>
							<width>100</width>
							<height>100</height>
							<texture border="33" colordiffuse="4D000000">masks/radius_33.png</texture>
						</control>
						<control type="image">
							<left>18</left>
							<top>18</top>
							<width>64</width>
							<height>64</height>
							<texture diffuse="masks/mainmenu-img.png" colordiffuse="unfocused_text">$INFO[ListItem.Icon]</texture>
							<aspectratio>keep</aspectratio>
						</control>
					</control>
				</itemlayout>
				<focusedlayout height="110" width="110">
					<control type="group">
						<left>5</left>
						<top>5</top>
						<width>100</width>
						<height>100</height>
						<control type="image">
							<left>0</left>
							<top>0</top>
							<width>100</width>
							<height>100</height>
							<texture border="33" colordiffuse="A6000000">masks/radius_33.png</texture>
						</control>
						<control type="image">
							<left>0</left>
							<top>0</top>
							<width>100</width>
							<height>100</height>
							<texture border="33" colordiffuse="$VAR[FocusColorTheme]" infill="false">masks/bordertexture-33_alt.png</texture>
							<visible>Control.HasFocus(3000)</visible>
						</control>
						<control type="image">
							<left>18</left>
							<top>18</top>
							<width>64</width>
							<height>64</height>
							<texture diffuse="masks/mainmenu-img.png" colordiffuse="$VAR[FocusColorTheme]">$INFO[ListItem.Icon]</texture>
							<aspectratio>keep</aspectratio>
						</control>
					</control>
				</focusedlayout>
			</control>

			<!-- Selected icon name -->
			<control type="label">
				<left>425</left>
				<right>45</right>
				<bottom>35</bottom>
				<height>35</height>
				<font>font27_title</font>
				<align>right</align>
				<aligny>center</aligny>
				<textcolor>60FFFFFF</textcolor>
				<label>$INFO[Container(3000).ListItem.Label]</label>
			</control>
		</control>
	</controls>
</window>
