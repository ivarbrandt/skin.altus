<?xml version="1.0" encoding="UTF-8"?>
<includes>

  <include name="FileManagerPanel">
		<param name="width"></param>
		<param name="right"></param>
		<param name="left">40</param>
		<definition>
			<control type="panel" id="$PARAM[list_id]">
				<left>$PARAM[left]</left>
				<top>150</top>
				<right>$PARAM[right]</right>
				<width>$PARAM[width]</width>
				<height>854</height>
				<focusposition>4</focusposition>
				<movement>3</movement>
				<onleft>$PARAM[onleft_id]</onleft>
				<onright>$PARAM[onright_id]</onright>
				<onup>$PARAM[list_id]</onup>
				<ondown>$PARAM[list_id]</ondown>
				<pagecontrol>$PARAM[scrollbar_id]</pagecontrol>
				<scrolltime tween="cubic" easing="out">500</scrolltime>
				<itemlayout height="122">
					<control type="image">
						<height>93</height>
						<texture border="46" colordiffuse="4D000000">masks/radius_46.png</texture>
					</control>
					<control type="image">
						<left>40</left>
						<top>26</top>
						<width>41</width>
						<height>41</height>
						<aspectratio>keep</aspectratio>
						<texture colordiffuse="unfocused_text">$VAR[ListWatchedIconVar]</texture>
					</control>
					<control type="label">
						<left>100</left>
						<right>160</right>
						<height>93</height>
						<aligny>center</aligny>
						<font>font32_bold</font>
						<label>$INFO[ListItem.Label]</label>
						<textcolor>unfocused_text</textcolor>
					</control>
					<control type="label">
						<right>46</right>
						<width>120</width>
						<height>93</height>
						<align>right</align>
						<aligny>center</aligny>
						<font>font27_title</font>
						<label>$INFO[ListItem.Label2]</label>
						<textcolor>grey</textcolor>
					</control>
				</itemlayout>
				<focusedlayout height="122">
					<control type="image">
						<height>93</height>
						<texture border="46" colordiffuse="4D000000">masks/radius_46.png</texture>
						<visible>!Control.HasFocus($PARAM[list_id])</visible>
					</control>
					<control type="image">
						<height>93</height>
						<texture border="46" colordiffuse="A6000000">masks/radius_46.png</texture>
						<visible>Control.HasFocus($PARAM[list_id])</visible>
					</control>
					<control type="image">
						<bottom>29</bottom>
						<texture border="46" colordiffuse="$VAR[FocusColorTheme]" infill="false">masks/bordertexture-46_alt.png</texture>
						<visible>Control.HasFocus($PARAM[list_id])</visible>
					</control>
					<control type="image">
						<left>40</left>
						<top>26</top>
						<width>41</width>
						<height>41</height>
						<aspectratio>keep</aspectratio>
						<texture colordiffuse="unfocused_text">$VAR[ListWatchedIconVar]</texture>
						<visible>!Control.HasFocus($PARAM[list_id])</visible>
					</control>
					<control type="image">
						<left>40</left>
						<top>26</top>
						<width>41</width>
						<height>41</height>
						<aspectratio>keep</aspectratio>
						<texture colordiffuse="$VAR[FocusColorTheme]">$VAR[ListWatchedIconVar]</texture>
						<visible>Control.HasFocus($PARAM[list_id])</visible>
					</control>
					<control type="label">
						<left>100</left>
						<right>160</right>
						<height>93</height>
						<aligny>center</aligny>
						<font>font32_bold</font>
						<label>$INFO[ListItem.Label]</label>
						<textcolor>unfocused_text</textcolor>
						<visible>!Control.HasFocus($PARAM[list_id])</visible>
					</control>
					<control type="label">
						<left>100</left>
						<right>160</right>
						<height>93</height>
						<aligny>center</aligny>
						<font>font32_bold</font>
						<scroll>true</scroll>
						<scrollspeed>150</scrollspeed>
						<label>$INFO[ListItem.Label]</label>
						<textcolor>$VAR[FocusColorTheme]</textcolor>
						<visible>Control.HasFocus($PARAM[list_id])</visible>
					</control>
					<control type="label">
						<right>46</right>
						<width>120</width>
						<height>93</height>
						<align>right</align>
						<aligny>center</aligny>
						<font>font27_title</font>
						<label>$INFO[ListItem.Label2]</label>
						<textcolor>grey</textcolor>
						<visible>!Control.HasFocus($PARAM[list_id])</visible>
					</control>
					<control type="label">
						<right>46</right>
						<width>120</width>
						<height>93</height>
						<align>right</align>
						<aligny>center</aligny>
						<font>font27_title</font>
						<label>$INFO[ListItem.Label2]</label>
						<textcolor>$VAR[FocusColorTheme]</textcolor>
						<visible>Control.HasFocus($PARAM[list_id])</visible>
					</control>
				</focusedlayout>
			</control>
		</definition>
	</include>

</includes>
